<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentacion"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="Presentacion.VistaLogin"
        mc:Ignorable="d"
        Title="VistaLogin" Height="600" Width="420">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <ui:Card HorizontalAlignment="Center" VerticalAlignment="Center" Width="340" Padding="24">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Text="Sistema de Gestión de Maie Alfajores" Margin="0,0,0,20"/>

                <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                    <Run Language="es-ar" Text="E-mail"/>
                </ui:TextBlock>
                <ui:TextBox PlaceholderText="E-mail" Margin="0,0,0,16"/>

                <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                    <Run Language="es-ar" Text="Contraseña"/>
                </ui:TextBlock>
                <ui:PasswordBox PlaceholderText="Contraseña" Margin="0,0,0,24"/>

                <ui:Button Content="Ingresar" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </ui:Card>
    </Grid>
</Window>