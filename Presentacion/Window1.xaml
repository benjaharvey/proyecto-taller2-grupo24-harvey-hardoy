<Window x:Class="Presentacion.UsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Usuarios" Height="500" Width="650">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Label Content="Email:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtEmail" Width="150" Margin="5,0"/>

            <Label Content="Password:" VerticalAlignment="Center"/>
            <PasswordBox x:Name="txtPassword" Width="120" Margin="5,0"/>

            <Label Content="Rol:" VerticalAlignment="Center"/>
            <ComboBox x:Name="cmbRol" Width="120" Margin="5,0"
                      DisplayMemberPath="Nombre" SelectedValuePath="Id"/>

            <Label Content="Sucursal Id:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtSucursalId" Width="50" Margin="5,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Right" Margin="0,40,0,0">
            <Button x:Name="btnAgregar" Content="Agregar" Width="80" Margin="5,0" Click="btnAgregar_Click"/>
            <Button x:Name="btnActualizar" Content="Actualizar" Width="80" Margin="5,0" Click="btnActualizar_Click"/>
            <Button x:Name="btnEliminar" Content="Eliminar" Width="80" Margin="5,0" Click="btnEliminar_Click"/>
        </StackPanel>

        <DataGrid x:Name="dataGridUsuarios" Grid.Row="1" Margin="0,20,0,0" AutoGenerateColumns="True" IsReadOnly="True"/>
    </Grid>
</Window>
