<Window x:Class="Presentacion.RolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Roles" Height="450" Width="500">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Label Content="Nombre:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtNombre" Width="200" Margin="5,0"/>
            <Button x:Name="btnAgregar" Content="Agregar" Width="80" Margin="5,0" Click="btnAgregar_Click"/>
            <Button x:Name="btnActualizar" Content="Actualizar" Width="80" Margin="5,0" Click="btnActualizar_Click"/>
            <Button x:Name="btnEliminar" Content="Eliminar" Width="80" Margin="5,0" Click="btnEliminar_Click"/>
            <Button x:Name="btnGestionarUsuarios" Content="Gestionar Usuarios" Width="130" Margin="5,0" Click="btnGestionarUsuarios_Click"/>
        </StackPanel>

        <DataGrid x:Name="dataGridRoles" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True"/>
    </Grid>
</Window>
