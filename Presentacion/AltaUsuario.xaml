<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentacion"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="Presentacion.AltaUsuario"
        mc:Ignorable="d"
        Title="AltaUsuario" Height="680" Width="420">
    <Grid>
        <ui:Card HorizontalAlignment="Center" VerticalAlignment="Center" Width="337" Padding="24">
            <StackPanel>
                <ui:TextBlock TextWrapping="Wrap" Text="Alta de Usuario" Margin="0,0,0,20"/>

                <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                    <Run Language="es-ar" Text="Email"/>
                </ui:TextBlock>
                <ui:TextBox PlaceholderText="Email" Margin="0,0,0,16"/>

                <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                    <Run Language="es-ar" Text="Contraseña"/>
                </ui:TextBlock>
                <ui:PasswordBox PlaceholderText="Contraseña" Margin="0,0,0,16"/>

                <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                    <Run Language="es-ar" Text="Confirmar Contraseña"/>
                </ui:TextBlock>
                <ui:PasswordBox PlaceholderText="Confirmar Contraseña" Margin="0,0,0,16"/>

                <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                    <Run Language="es-ar" Text="Fecha de Nacimiento"/>
                </ui:TextBlock>
                <DatePicker Margin="0,0,0,16" HorizontalAlignment="Stretch"/>

                <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                    <Run Language="es-ar" Text="Dirección"/>
                </ui:TextBlock>
                <ui:TextBox PlaceholderText="Dirección" Margin="0,0,0,16"/>

                <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                    <Run Language="es-ar" Text="Rol"/>
                </ui:TextBlock>
                <ComboBox Margin="0,0,0,16" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Administrador"/>
                    <ComboBoxItem Content="Vendedor"/>
                    <ComboBoxItem Content="Cocinero"/>
                </ComboBox>

                <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                    <Run Language="es-ar" Text="Sucursal"/>
                </ui:TextBlock>
                <ComboBox Margin="0,0,0,24" HorizontalAlignment="Stretch">
                    <!-- Se completa con las sucursales cuando conectes la lógica -->
                </ComboBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:Button Content="Guardar" Margin="0,0,8,0" Width="150"/>
                    <ui:Button Content="Cancelar" Width="150"/>
                </StackPanel>
            </StackPanel>
        </ui:Card>
    </Grid>
</Window>
