<UserControl x:Class="Presentacion.Vistas.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Presentacion.ViewModels"
             xmlns:ctrl="clr-namespace:Presentacion.Controles"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950">

    <!-- NAV 1 | ESTRUCTURA: Grid de 3 filas. Row 0 = encabezado, Row 1 = filtros, Row 2 = contenido (tabla + panel lateral de formulario). El modal de insumos (NAV 7) se dibuja encima de las 3 filas con Grid.RowSpan. ViewModel: ProductosViewModel -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- NAV 2 | ENCABEZADO (Row 0): título y subtítulo fijos, sin bindings -->
        <!-- Header Section -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Catálogo de Productos" Style="{StaticResource HeaderTitleStyle}"/>
            <TextBlock Text="Administración de productos, precios y fórmulas de recetas" Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- NAV Ayuda | BOTÓN AYUDA: control compartido BotonAyuda (Controles/BotonAyuda.xaml). Abre el manual de usuario en PDF. Está en la misma celda del encabezado, alineado arriba a la derecha -->
        <ctrl:BotonAyuda Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" />

        <!-- NAV 3 | FILTROS (Row 1): 3 columnas. Buscador (*), combo de categoría (200 px) y botón Limpiar. Cualquier cambio dispara AplicarFiltro en el VM, que arma una nueva lista Productos desde la lista completa -->
        <!-- Filters Section -->
        <Border Grid.Row="1" Style="{StaticResource MaieCardStyle}" Margin="0,0,0,16" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- NAV 3a | BUSCADOR: BusquedaTexto (OnBusquedaTextoChanged → AplicarFiltro). Busca en nombre y en nombre de categoría. El texto gris es un VisualBrush que aparece solo con el Text vacío -->
                <!-- Search Input -->
                <TextBox Grid.Column="0" 
                         Text="{Binding BusquedaTexto, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="100"
                         Padding="12,8"
                         Margin="0,0,12,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="{StaticResource SecondaryBrush}"
                         FontSize="13">
                    <TextBox.Resources>
                        <VisualBrush x:Key="HintBrush" TileMode="None" Opacity="0.6" Stretch="None" AlignmentX="Left">
                            <VisualBrush.Visual>
                                <TextBlock Text="🔍  Buscar por nombre" Foreground="{StaticResource TextBodyBrush}" FontSize="12" Margin="18,0,0,0"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- NAV 3b | FILTRO DE CATEGORÍA: ItemsSource = Categorias, SelectedItem = FiltroCategoria. Acá null significa "sin filtro" (no hay un ítem Todas) -->
                <!-- Category Filter -->
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding Categorias}"
                          SelectedItem="{Binding FiltroCategoria}"
                          DisplayMemberPath="Nombre"
                          Margin="0,0,12,0"
                          Padding="8,6"
                          BorderBrush="{StaticResource SecondaryBrush}"
                          VerticalContentAlignment="Center"/>

                <!-- NAV 3c | LIMPIAR FILTROS: LimpiarFiltrosCommand deja BusquedaTexto vacío y FiltroCategoria en null -->
                <Button Grid.Column="2" 
                        Content="Limpiar Filtros" 
                        Command="{Binding LimpiarFiltrosCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="14,6"/>
            </Grid>
        </Border>

        <!-- NAV 4 | CONTENIDO (Row 2): 2 columnas. Izquierda = tabla de productos (*), derecha = panel de formulario/receta (360 px fijos) -->
        <!-- Main Content Area: Products Grid & Detail / Edit Drawer -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- NAV 4a | TABLA DE PRODUCTOS: Productos (ProductoDTO). Al elegir una fila, SelectedProducto dispara OnSelectedProductoChanged, que carga el formulario en modo edición. Columnas: Nombre, NombreCategoria, Precio, Costo, Estado y Acciones -->
            <!-- Products Table -->
            <Border Grid.Column="0" Style="{StaticResource MaieCardStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding Productos}"
                          SelectedItem="{Binding SelectedProducto}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EFECE6"
                          Background="White"
                          BorderThickness="0"
                          RowHeight="46"
                          SelectionMode="Single">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontFamily" Value="Noto Serif" />
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White" />
                            <Setter Property="Margin" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#F2EAE4" />
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*" />
                        <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="*" />
                        <DataGridTextColumn Header="Precio Unit." Binding="{Binding Precio, StringFormat='${0:N2}'}" Width="110" />
                        <DataGridTextColumn Header="Costo Unit." Binding="{Binding Costo, StringFormat='${0:N2}'}" Width="110" />
                        
                        <!-- NAV 4a-1 | COLUMNA ESTADO: etiqueta de color. Verde con "Activo" por defecto; rojo con "Inactivo" si Activo es False (DataTrigger) -->
                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="Estado" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E6F4EA" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                                        <Setter Property="Background" Value="#FCE8E6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Activo" />
                                                    <Setter Property="Foreground" Value="#137333" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Activo}" Value="False">
                                                            <Setter Property="Text" Value="Inactivo" />
                                                            <Setter Property="Foreground" Value="#C5221F" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- NAV 4a-2 | COLUMNA ACCIONES: dos botones por fila. Sus comandos viven en el ViewModel, no en la fila, por eso el Binding sube con RelativeSource AncestorType=UserControl hasta el DataContext y pasa la fila con CommandParameter={Binding}. Lápiz = EditarProductoCommand (selecciona la fila). Segundo botón = ToggleEstadoProductoCommand (pide confirmación y da de baja o reactiva; el ícono cambia con un DataTrigger sobre Activo) -->
                        <!-- Actions Column -->
                        <DataGridTemplateColumn Header="Acciones" Width="120">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontFamily" Value="Noto Serif" />
                                    <Setter Property="Padding" Value="8,10" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="✏️" 
                                                ToolTip="Editar Producto y Receta"
                                                Command="{Binding DataContext.EditarProductoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostIconButton}"
                                                Margin="4,0"
                                                Padding="6,4"
                                                FontSize="14"
                                                VerticalAlignment="Center"/>
                                        <Button ToolTip="Cambiar Estado Activo/Inactivo"
                                                Command="{Binding DataContext.ToggleEstadoProductoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostIconButton}"
                                                Margin="4,0"
                                                Padding="6,4"
                                                FontSize="14"
                                                VerticalAlignment="Center">
                                            <Button.Content>
                                                <TextBlock FontSize="14">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="🗑️"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                    <Setter Property="Text" Value="🔄"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button.Content>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- NAV 5 | PANEL DE FORMULARIO (columna derecha): sirve para crear un producto nuevo o editar el elegido. El título viene de FormTitulo ("Nuevo Producto" o "Editar ...") -->
            <!-- Product Form / Recipe Detail Drawer -->
            <Border Grid.Column="1" 
                    Width="360" 
                    Margin="16,0,0,0" 
                    Style="{StaticResource MaieCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitulo}" Style="{StaticResource SubheaderTitleStyle}" Margin="0,0,0,16"/>

                        <!-- NAV 5a | CATEGORÍA: FormCategoria (ItemsSource = Categorias). Está en la columna 1 del Grid; la columna 0 quedó vacía (resto de un campo código que ya no existe) -->
                        <!-- Code & Category -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Categoría" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding FormCategoria}" DisplayMemberPath="Nombre" Padding="6,4" BorderBrush="{StaticResource SecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- NAV 5b | NOMBRE, PRECIO Y COSTO: FormNombre (máximo 40), FormPrecio y FormCosto (máximo 12). Sin UpdateSourceTrigger: el valor llega al VM cuando el campo pierde el foco -->
                        <!-- Name -->
                        <TextBlock Text="Nombre del Producto" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormNombre}" MaxLength="40" Padding="6,4" Margin="0,0,0,12" BorderBrush="{StaticResource SecondaryBrush}"/>

                        <!-- Price -->
                        <TextBlock Text="Precio Unitario ($)" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormPrecio}" MaxLength="12" Padding="6,4" Margin="0,0,0,12" BorderBrush="{StaticResource SecondaryBrush}"/>

                        <!-- Cost -->
                        <TextBlock Text="Costo de Producción por Unidad ($)" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormCosto}" MaxLength="12" Padding="6,4" Margin="0,0,0,16" BorderBrush="{StaticResource SecondaryBrush}"/>

                        <Separator Margin="0,0,0,12" Background="#E2DCD5"/>

                        <!-- NAV 5c | RECETA (RF-08): título y botón + Insumo (AbrirModalAgregarInsumoCommand abre el modal NAV 7) -->
                        <!-- Recipe Section (RF-08) -->
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Fórmula / Receta (por unidad)" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                            <Button Content="+ Insumo" 
                                    Command="{Binding AbrirModalAgregarInsumoCommand}"
                                    DockPanel.Dock="Right" 
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Foreground="{StaticResource AccentBrush}"
                                    FontWeight="SemiBold"
                                    FontSize="11"
                                    Padding="10,4"/>
                        </DockPanel>

                        <!-- NAV 5d | LISTA DE INSUMOS DE LA RECETA: FormRecetaInsumos (InsumoRecetaItem). Cada fila muestra InsumoNombre, Cantidad y UnidadMedida, y un botón ✖ con QuitarInsumoRecetaCommand (también por RelativeSource, con la fila como parámetro) -->
                        <!-- Recipe Ingredients List -->
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="8" Margin="0,0,0,16">
                            <ItemsControl ItemsSource="{Binding FormRecetaInsumos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding InsumoNombre}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Cantidad, StringFormat='{}{0}'}" FontSize="12" FontWeight="SemiBold" Margin="8,0,2,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding UnidadMedida}" FontSize="12" Foreground="{StaticResource TextBodyBrush}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" 
                                                    Content="✖" 
                                                    Command="{Binding DataContext.QuitarInsumoRecetaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource GhostIconButton}"
                                                    Foreground="#C5221F"
                                                    Margin="8,0,0,0"
                                                    FontSize="11"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- NAV 5e | BOTONES: Cancelar (CancelarFormularioCommand, limpia el formulario y vuelve a "Nuevo Producto") y Guardar Producto (GuardarFormularioCommand, crea o actualiza según EsEdicion) -->
                        <!-- Form Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancelar" 
                                    Command="{Binding CancelarFormularioCommand}"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Padding="14,6"
                                    Margin="0,0,8,0"/>
                            <Button Content="Guardar Producto" 
                                    Command="{Binding GuardarFormularioCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="14,6"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- NAV 7 | MODAL AGREGAR INSUMO: un Grid semitransparente (#70000000) que cubre toda la vista. Está Collapsed y un DataTrigger lo muestra cuando MostrarModalAgregarInsumo es True -->
        <!-- Modal: Agregar Insumo a la Receta -->
        <Grid Grid.RowSpan="3" Background="#70000000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MostrarModalAgregarInsumo}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- NAV 7a | CAJA DEL MODAL: combo de insumos (InsumosDisponibles / InsumoSeleccionadoParaReceta), cantidad requerida por unidad (NuevoInsumoCantidad) y la unidad de medida del insumo elegido (InsumoSeleccionadoParaReceta.UnidadMedida) -->
            <Border Width="380" Background="White" CornerRadius="8" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Agregar Insumo a la Receta" Style="{StaticResource SubheaderTitleStyle}" Margin="0,0,0,4"/>
                    <TextBlock Text="Indique el ingrediente y la cantidad requerida por unidad" Style="{StaticResource BodyTextStyle}" FontSize="12" Margin="0,0,0,16"/>

                    <TextBlock Text="Insumo (*)" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding InsumosDisponibles}" 
                              SelectedItem="{Binding InsumoSeleccionadoParaReceta}" 
                              DisplayMemberPath="Nombre"
                              Padding="6,4" 
                              Margin="0,0,0,12" 
                              BorderBrush="{StaticResource SecondaryBrush}"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Cantidad requerida (*)" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NuevoInsumoCantidad}" MaxLength="9" Padding="6,4" BorderBrush="{StaticResource SecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,4">
                            <TextBlock Text="{Binding InsumoSeleccionadoParaReceta.UnidadMedida}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- NAV 7b | BOTONES DEL MODAL: Cancelar (CerrarModalAgregarInsumoCommand) y Agregar a Receta (ConfirmarAgregarInsumoCommand, valida y suma el insumo a FormRecetaInsumos) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" 
                                Command="{Binding CerrarModalAgregarInsumoCommand}"
                                Style="{StaticResource OutlineButtonStyle}"
                                Padding="12,6"
                                Margin="0,0,8,0"/>
                        <Button Content="Agregar a Receta" 
                                Command="{Binding ConfirmarAgregarInsumoCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="12,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
