<UserControl x:Class="Presentacion.Vistas.HistorialVentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:Presentacion.Controles"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1100">

    <!-- NAV 1 | ESTRUCTURA: Grid de 4 filas. Row 0 = encabezado, Row 1 = filtros, Row 2 = tabla + detalle de la venta, Row 3 = totales del período. ViewModel: HistorialVentasViewModel (solo el admin carga datos: SesionActual.EsAdmin) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- NAV 2 | ENCABEZADO (Row 0): título y subtítulo fijos, sin bindings -->
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Historial de Ventas" Style="{StaticResource HeaderTitleStyle}"/>
            <TextBlock Text="Ventas confirmadas y canceladas de todas las sucursales"
                       Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- NAV Ayuda | BOTÓN AYUDA: control compartido BotonAyuda (Controles/BotonAyuda.xaml). Abre el manual de usuario en PDF. Está en la misma celda del encabezado, alineado arriba a la derecha -->
        <ctrl:BotonAyuda Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" />

        <!-- NAV 3 | FILTROS COMBINABLES (Row 1): todos son opcionales y se aplican juntos al apretar Buscar. Cada uno se enlaza a una propiedad Filtro... del ViewModel (null = sin filtro) -->
        <!-- Filtros combinables -->
        <Border Grid.Row="1" Style="{StaticResource MaieCardStyle}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <!-- NAV 3a | SUCURSAL: ItemsSource = Sucursales, SelectedValue = FiltroSucursalId (int?). Las sucursales sin venta están excluidas en CargarCombos -->
                    <StackPanel Width="180" Margin="0,0,12,10">
                        <TextBlock Text="Sucursal" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Sucursales}"
                                  DisplayMemberPath="Nombre"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding FiltroSucursalId}"
                                  Padding="8,5" Height="36"/>
                    </StackPanel>

                    <!-- NAV 3b | DESDE y HASTA: FiltroDesde y FiltroHasta (DateTime?). Buscar avisa si desde es posterior a hasta -->
                    <StackPanel Width="150" Margin="0,0,12,10">
                        <TextBlock Text="Desde" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding FiltroDesde}"/>
                    </StackPanel>

                    <StackPanel Width="150" Margin="0,0,12,10">
                        <TextBlock Text="Hasta" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding FiltroHasta}"/>
                    </StackPanel>

                    <!-- NAV 3c | CLIENTE: FiltroClienteTexto, por nombre o DNI. UpdateSourceTrigger=PropertyChanged: el valor llega al VM mientras se escribe, pero la búsqueda se hace recién con el botón Buscar -->
                    <StackPanel Width="220" Margin="0,0,12,10">
                        <TextBlock Text="Cliente (nombre o DNI)" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FiltroClienteTexto, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="100"
                                 Padding="8,5" BorderBrush="{StaticResource SecondaryBrush}" Height="36"/>
                    </StackPanel>

                    <!-- NAV 3d | VENDEDOR: ItemsSource = Vendedores (solo usuarios activos con rol Vendedor), SelectedValue = FiltroUsuarioId -->
                    <StackPanel Width="200" Margin="0,0,12,10">
                        <TextBlock Text="Vendedor" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Vendedores}"
                                  DisplayMemberPath="NombreCompleto"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding FiltroUsuarioId}"
                                  Padding="8,5" Height="36"/>
                    </StackPanel>

                    <!-- NAV 3e | MÉTODO DE PAGO: ItemsSource = MetodosPago (los valores del enum MetodoPago), SelectedItem = FiltroMetodoPago (MetodoPago? nulo = todos) -->
                    <StackPanel Width="160" Margin="0,0,12,10">
                        <TextBlock Text="Método de pago" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding MetodosPago}"
                                  SelectedItem="{Binding FiltroMetodoPago}"
                                  Padding="8,5" Height="36"/>
                    </StackPanel>
                </WrapPanel>

                <!-- NAV 3f | BOTONES: Limpiar filtros (LimpiarFiltrosCommand, deja todo en null y vuelve a buscar) y Buscar (BuscarCommand, arma un VentaFiltro, llama al caso de uso ListarVentas y reemplaza la lista Ventas) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button Content="Limpiar filtros"
                            Command="{Binding LimpiarFiltrosCommand}"
                            Style="{StaticResource OutlineButtonStyle}"
                            Padding="14,6" Margin="0,0,8,0"/>
                    <Button Content="Buscar"
                            Command="{Binding BuscarCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="20,6"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- NAV 4 | TABLA + DETALLE (Row 2): 2 columnas. Izquierda = tabla de ventas (2*), derecha = detalle de la venta elegida (mínimo 340 px) -->
        <!-- Grilla + detalle de la venta seleccionada -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- NAV 4a | TABLA DE VENTAS: Ventas (VentaDTO). La fila elegida va a VentaSeleccionada, que alimenta el panel de detalle. Columnas: Fecha, NumeroComprobante, NombreSucursal, NombreCliente, NombreVendedor, MetodoPago, CantidadItems, Total y Estado -->
            <Border Grid.Column="0" Style="{StaticResource MaieCardStyle}" Padding="0" Margin="0,0,12,0">
                <DataGrid ItemsSource="{Binding Ventas}"
                          SelectedItem="{Binding VentaSeleccionada}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EFECE6"
                          Background="White"
                          BorderThickness="0"
                          RowHeight="42"
                          SelectionMode="Single">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontFamily" Value="Noto Serif" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="130" />
                        <DataGridTextColumn Header="N° Venta" Binding="{Binding NumeroComprobante}" Width="140" />
                        <DataGridTextColumn Header="Sucursal" Binding="{Binding NombreSucursal}" Width="*" />
                        <DataGridTextColumn Header="Cliente" Binding="{Binding NombreCliente}" Width="2*" />
                        <DataGridTextColumn Header="Vendedor" Binding="{Binding NombreVendedor}" Width="*" />
                        <DataGridTextColumn Header="Pago" Binding="{Binding MetodoPago}" Width="100" />
                        <DataGridTextColumn Header="Unid." Binding="{Binding CantidadItems}" Width="60" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='${0:N2}'}" Width="100" />

                        <!-- NAV 4a-1 | COLUMNA ESTADO: DataGridTemplateColumn con una etiqueta de color. DataTrigger: verde si CONFIRMADA (por defecto) y ámbar si Estado es CANCELADA -->
                        <!-- Estado: verde confirmada, ambar cancelada -->
                        <DataGridTemplateColumn Header="Estado" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E6F4EA" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Estado}" Value="CANCELADA">
                                                        <Setter Property="Background" Value="#FEF7E0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Estado}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#137333" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Estado}" Value="CANCELADA">
                                                            <Setter Property="Foreground" Value="#B06000" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- NAV 5 | DETALLE DE LA VENTA SELECCIONADA (columna derecha): todo se enlaza a VentaSeleccionada.X. Si no hay selección, los bindings quedan vacíos -->
            <!-- Detalle de la venta seleccionada -->
            <Border Grid.Column="1" Style="{StaticResource MaieCardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- NAV 5a | CABECERA: NumeroComprobante, Fecha, NombreCliente, DniCliente y NombreVendedor -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding VentaSeleccionada.NumeroComprobante}"
                                   FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="{Binding VentaSeleccionada.Fecha, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                   FontSize="11" Foreground="{StaticResource TextBodyBrush}" Margin="0,2,0,10"/>
                        <TextBlock Text="{Binding VentaSeleccionada.NombreCliente}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextBodyBrush}" Margin="0,2,0,0">
                            <Run Text="DNI: "/>
                            <Run Text="{Binding VentaSeleccionada.DniCliente, Mode=OneWay}"/>
                            <Run Text="  ·  "/>
                            <Run Text="{Binding VentaSeleccionada.NombreVendedor, Mode=OneWay}"/>
                        </TextBlock>
                        <Separator Margin="0,10,0,6" Background="#E2DCD5"/>
                    </StackPanel>

                    <!-- NAV 5b | RENGLONES: ItemsControl sobre VentaSeleccionada.Detalles. El DataTemplate dibuja cada renglón con NombreProducto, Cantidad x PrecioUnit y Subtotal -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding VentaSeleccionada.Detalles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding NombreProducto}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="10" Foreground="{StaticResource TextBodyBrush}">
                                                <Run Text="{Binding Cantidad, Mode=OneWay}"/>
                                                <Run Text=" x $"/>
                                                <Run Text="{Binding PrecioUnit, Mode=OneWay, StringFormat='{}{0:N2}'}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Subtotal, StringFormat='${0:N2}'}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- NAV 5c | TOTAL Y ACCIONES: Ver comprobante (VerComprobanteCommand, genera el PDF y lo abre) y Cancelar venta (CancelarVentaCommand, repone el stock). El botón Cancelar solo se habilita si PuedeCancelarSeleccionada, o sea si la venta está CONFIRMADA -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <DockPanel>
                            <TextBlock Text="TOTAL" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="{Binding VentaSeleccionada.Total, StringFormat='${0:N2}'}"
                                       DockPanel.Dock="Right" HorizontalAlignment="Right"
                                       FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        </DockPanel>

                        <Button Content="Ver comprobante"
                                Command="{Binding VerComprobanteCommand}"
                                Style="{StaticResource OutlineButtonStyle}"
                                Padding="10,7" Margin="0,12,0,6"/>
                        <Button Content="Cancelar venta"
                                Command="{Binding CancelarVentaCommand}"
                                IsEnabled="{Binding PuedeCancelarSeleccionada}"
                                Background="#C5221F" Foreground="White"
                                Padding="10,7"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- NAV 6 | TOTALES DEL PERÍODO (Row 3): TotalOperaciones, TotalUnidades y TotalImporte. Son propiedades calculadas del VM que cuentan SOLO las ventas CONFIRMADAS (las canceladas no suman). Se actualizan con NotificarTotales() -->
        <!-- Totales del período: solo ventas confirmadas -->
        <Border Grid.Row="3" Style="{StaticResource MaieCardStyle}" Padding="12" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Margin="0,0,22,0" FontSize="12" Foreground="{StaticResource TextBodyBrush}">
                    <Run Text="Operaciones: "/>
                    <Run Text="{Binding TotalOperaciones, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock Margin="0,0,22,0" FontSize="12" Foreground="{StaticResource TextBodyBrush}">
                    <Run Text="Unidades: "/>
                    <Run Text="{Binding TotalUnidades, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource TextBodyBrush}">
                    <Run Text="Importe: "/>
                    <Run Text="{Binding TotalImporte, Mode=OneWay, StringFormat='${0:N2}'}" FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
