<UserControl x:Class="Presentacion.Vistas.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Presentacion.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:ctrl="clr-namespace:Presentacion.Controles"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- NAV R-1 | CONVERSOR BoolToVis: convierte un bool del VM en Visible o Collapsed. Lo usan los mensajes de sin datos (ProduccionSinDatos, MetodoPagoSinDatos, etc.) -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- NAV R-2 | ESTILO ENCABEZADO DE GRILLAS: ReporteColumnHeaderStyle, mismo look que la tabla consolidada. Se aplica con ColumnHeaderStyle en cada DataGrid -->
        <Style x:Key="ReporteColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Noto Serif" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
        </Style>

        <!-- NAV R-3 | ESTILO CELDAS NUMÉRICAS: ReporteNumeroCellStyle, alineadas a la derecha para comparar de un vistazo. Se aplica con ElementStyle en las columnas del reporte de stock -->
        <Style x:Key="ReporteNumeroCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </UserControl.Resources>

    <!-- NAV 0a | ESTRUCTURA GENERAL: un ScrollViewer con un Grid de 9 filas (Row 0 a Row 8), una por bloque. Todo se enlaza a ReportesViewModel. Los bloques se cargan con los métodos Cargar... y RefrescarReportes -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,20,0">
        <Grid Margin="0,0,10,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- NAV 0 | ENCABEZADO (Row 0): título y subtítulo, texto fijo sin bindings -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Reportes y Estadísticas de Gestión" Style="{StaticResource HeaderTitleStyle}"/>
                <TextBlock Text="Métricas consolidadas de ventas por mostrador y producción en cocina" Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- NAV Ayuda | BOTÓN AYUDA: control compartido BotonAyuda (Controles/BotonAyuda.xaml). Abre el manual de usuario en PDF. Está en la misma celda del encabezado, alineado arriba a la derecha -->
            <ctrl:BotonAyuda Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" />

            <!-- NAV 1 | BARRA DE FILTROS (Row 1): FechaDesde, FechaHasta y SucursalFiltro. Cada cambio dispara un On...Changed del VM y recarga los reportes. No hay botón Aplicar. Valen para casi todos los reportes (Ventas por Sucursal ignora la sucursal) -->
            <Border Grid.Row="1" Style="{StaticResource MaieCardStyle}" Margin="0,0,0,24" Padding="16,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Filtrar por:" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="13"/>
                    
                    <TextBlock Text="Desde:" FontSize="12" Foreground="{StaticResource TextBodyBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <!-- NAV 1a | FECHA DESDE: FechaDesde (DateTime?, por defecto hoy menos 30 días) → OnFechaDesdeChanged → AplicarFiltrosDeFecha → RefrescarReportes -->
                    <DatePicker SelectedDate="{Binding FechaDesde}" Width="130" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <TextBlock Text="Hasta:" FontSize="12" Foreground="{StaticResource TextBodyBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <!-- NAV 1b | FECHA HASTA: FechaHasta (DateTime?, por defecto hoy) → OnFechaHastaChanged → AplicarFiltrosDeFecha. El repositorio la usa como hastaExclusivo (hasta mas un día) -->
                    <DatePicker SelectedDate="{Binding FechaHasta}" Width="130" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <TextBlock Text="Sucursal:" FontSize="12" Foreground="{StaticResource TextBodyBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <!-- NAV 1c | COMBO SUCURSAL: Sucursales (Todas las Sucursales + puntos de venta, sin Casa Central ni Fábrica) / SucursalFiltro → OnSucursalFiltroChanged → RefrescarReportes sin Ventas por Sucursal. El VM lo traduce a int? (null = todas) -->
                    <ComboBox ItemsSource="{Binding Sucursales}" 
                              SelectedItem="{Binding SucursalFiltro}"
                              Padding="10,6"
                              Width="230"
                              BorderBrush="{StaticResource SecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- NAV 2 | TARJETAS KPI (Row 2): cuatro tarjetas en 4 columnas. Las llena CargarResumenVentas con el resultado de ObtenerResumenVentas -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- NAV 2a | TARJETA GANANCIAS: TotalGanancia (número grande) y TotalIngresosVentas (Facturado, abajo). Ganancia = suma de cantidad x (PrecioUnit menos CostoUnit) de cada renglón; con costos en 0 coincide con lo facturado -->
                <Border Grid.Column="0" Style="{StaticResource MaieCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="💰 Ganancias por Ventas" FontSize="12" Foreground="{StaticResource TextBodyBrush}"/>
                        <TextBlock Text="{Binding TotalGanancia, StringFormat='${0:N2}'}"
                                   FontFamily="Noto Serif"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,6,0,4"/>
                        <TextBlock Text="{Binding TotalIngresosVentas, StringFormat='Facturado: ${0:N2}'}" FontSize="11" Foreground="#137333" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- NAV 2b | TARJETA VENTAS CONFIRMADAS: TotalOperacionesVenta (cantidad de tickets). Solo cuenta ventas en estado CONFIRMADA -->
                <Border Grid.Column="1" Style="{StaticResource MaieCardStyle}" Margin="4,0,8,0">
                    <StackPanel>
                        <TextBlock Text="🧾 Ventas Confirmadas" FontSize="12" Foreground="{StaticResource TextBodyBrush}"/>
                        <TextBlock Text="{Binding TotalOperacionesVenta, StringFormat='{}{0} tickets'}" 
                                   FontFamily="Noto Serif" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,6,0,4"/>
                        <TextBlock Text="Sin cancelaciones ni anuladas" FontSize="11" Foreground="{StaticResource TextBodyBrush}"/>
                    </StackPanel>
                </Border>

                <!-- NAV 2c | TARJETA UNIDADES VENDIDAS: TotalUnidadesVendidas; el texto de abajo repite la sucursal elegida (SucursalFiltro) -->
                <Border Grid.Column="2" Style="{StaticResource MaieCardStyle}" Margin="4,0,8,0">
                    <StackPanel>
                        <TextBlock Text="📦 Unidades Vendidas" FontSize="12" Foreground="{StaticResource TextBodyBrush}"/>
                        <TextBlock Text="{Binding TotalUnidadesVendidas, StringFormat='{}{0:N0} un.'}" 
                                   FontFamily="Noto Serif" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,6,0,4"/>
                        <TextBlock Text="{Binding SucursalFiltro}" FontSize="11" Foreground="{StaticResource TextBodyBrush}"/>
                    </StackPanel>
                </Border>

                <!-- NAV 2d | TARJETA TICKET PROMEDIO: TicketPromedio = facturado dividido ventas confirmadas (el comentario original decía Unidades Elaboradas, pero la tarjeta muestra el ticket promedio) -->
                <Border Grid.Column="3" Style="{StaticResource MaieCardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="💰 Ticket Promedio" FontSize="12" Foreground="{StaticResource TextBodyBrush}"/>
                        <TextBlock Text="{Binding TicketPromedio, StringFormat='${0:N2}'}" 
                                   FontFamily="Noto Serif" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,6,0,4"/>
                        <TextBlock Text="Facturado ÷ ventas confirmadas" FontSize="11" Foreground="{StaticResource TextBodyBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- NAV 3 | PRODUCCIÓN POR PRODUCTO (Row 3): usa los filtros globales (fechas y sucursal) y además un combo de categoría propio, arriba a la derecha (CategoriasFiltro / ProduccionCategoriaFiltro → OnProduccionCategoriaFiltroChanged → CargarProduccion). Id 0 = Todas las categorías -->
            <Border Grid.Row="3" Style="{StaticResource MaieCardStyle}" Margin="0,0,0,20" Padding="16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <TextBlock Text="Categoría:" FontSize="12" Foreground="{StaticResource TextBodyBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding CategoriasFiltro}"
                                      SelectedItem="{Binding ProduccionCategoriaFiltro}"
                                      DisplayMemberPath="Nombre"
                                      Width="200" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="🧑‍🍳 Producción por Producto"
                                   Style="{StaticResource SubheaderTitleStyle}"
                                   FontSize="15" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid Height="320">
                        <!-- NAV 3a | GRÁFICO DE COLUMNAS (LiveCharts): ProduccionSeries (valores), ProduccionXAxes (nombres de producto, rotados) y ProduccionYAxes (eje fijo en el VM). Todo lo arma CargarProduccion -->
                        <lvc:CartesianChart Series="{Binding ProduccionSeries}"
                                            XAxes="{Binding ProduccionXAxes}"
                                            YAxes="{Binding ProduccionYAxes}"/>
                        <!-- NAV 3b | MENSAJE SIN DATOS: se superpone al gráfico y se ve solo si ProduccionSinDatos es true (conversor BoolToVis) -->
                        <TextBlock Text="No hay producción registrada con los filtros seleccionados."
                                   Style="{StaticResource BodyTextStyle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ProduccionSinDatos, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- NAV 4 | RECAUDACIÓN POR MÉTODO DE PAGO (Row 4): torta a la izquierda y tabla con resumen a la derecha. Lo llena CargarRecaudacionPorMetodoPago -->
            <Border Grid.Row="4" Style="{StaticResource MaieCardStyle}" Margin="0,0,0,20" Padding="16">
                <StackPanel>
                    <TextBlock Text="💳 Recaudación por Medio de Pago" Style="{StaticResource SubheaderTitleStyle}" FontSize="15" Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- NAV 4a | TORTA (PieChart): MetodoPagoSeries, una porción por método con recaudación mayor a cero. El mensaje de abajo se ve con MetodoPagoSinDatos -->
                        <Grid Grid.Column="0" Height="260" Margin="0,0,20,0">
                            <lvc:PieChart Series="{Binding MetodoPagoSeries}" LegendPosition="Right" />
                            <TextBlock Text="No hay ventas confirmadas en el período seleccionado."
                                       Style="{StaticResource BodyTextStyle}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding MetodoPagoSinDatos, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <StackPanel Grid.Column="1">
                            <!-- NAV 4b | TABLA POR MÉTODO: MetodosPago (RecaudacionPorMetodoPagoDTO). Columnas: Nombre, TotalRecaudado, CantidadVentas, TicketPromedio. Aparecen también los métodos en cero -->
                            <DataGrid ItemsSource="{Binding MetodosPago}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#EFECE6"
                                      Background="White"
                                      BorderThickness="0"
                                      RowHeight="38"
                                      SelectionMode="Single"
                                      ColumnHeaderStyle="{StaticResource ReporteColumnHeaderStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Método" Binding="{Binding Nombre}" Width="1.2*" />
                                    <DataGridTextColumn Header="Recaudado" Binding="{Binding TotalRecaudado, StringFormat='${0:N2}'}" Width="*" />
                                    <DataGridTextColumn Header="Tickets" Binding="{Binding CantidadVentas}" Width="Auto" />
                                    <DataGridTextColumn Header="Ticket prom." Binding="{Binding TicketPromedio, StringFormat='${0:N2}'}" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- NAV 4c | RESUMEN: TotalRecaudadoMetodoPago, ParticipacionEfectivo y ParticipacionDigital (digital = tarjeta mas transferencia = 100 menos efectivo). Se calculan en CargarRecaudacionPorMetodoPago -->
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalRecaudadoMetodoPago, StringFormat='Total del período: ${0:N2}'}"
                                               FontWeight="SemiBold" FontSize="13"
                                               Foreground="{StaticResource PrimaryBrush}" />

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Efectivo" FontSize="11" Foreground="{StaticResource TextBodyBrush}" />
                                            <TextBlock Text="{Binding ParticipacionEfectivo, StringFormat='{}{0}%'}"
                                                       FontSize="16" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Digital (tarjeta + transf.)" FontSize="11" Foreground="{StaticResource TextBodyBrush}" />
                                            <TextBlock Text="{Binding ParticipacionDigital, StringFormat='{}{0}%'}"
                                                       FontSize="16" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- NAV 5 | RECAUDACIÓN POR CATEGORÍA (Row 5): gráfico de barras a la izquierda y tabla con resumen a la derecha. Lo llena CargarRecaudacionPorCategoria. No tiene filtro de categoría propio (muestra todas) -->
            <Border Grid.Row="5" Style="{StaticResource MaieCardStyle}" Margin="0,0,0,20" Padding="16">
                <StackPanel>
                    <TextBlock Text="🏷️ Recaudación por Categoría" Style="{StaticResource SubheaderTitleStyle}" FontSize="15" Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- NAV 5a | BARRAS (CartesianChart): CategoriaSeries (valores), CategoriaXAxes (nombres de categoría) y CategoriaYAxes (eje fijo en el VM). Mensaje sin datos: CategoriaSinDatos -->
                        <Grid Grid.Column="0" Height="260" Margin="0,0,20,0">
                            <lvc:CartesianChart Series="{Binding CategoriaSeries}"
                                                XAxes="{Binding CategoriaXAxes}"
                                                YAxes="{Binding CategoriaYAxes}" />
                            <TextBlock Text="No hay ventas confirmadas en el período seleccionado."
                                       Style="{StaticResource BodyTextStyle}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding CategoriaSinDatos, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <StackPanel Grid.Column="1">
                            <!-- NAV 5b | TABLA POR CATEGORÍA: Categorias (RecaudacionPorCategoriaDTO). Columnas: NombreCategoria, TotalRecaudado, Participacion (%), Unidades, PrecioPromedio -->
                            <DataGrid ItemsSource="{Binding Categorias}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#EFECE6"
                                      Background="White"
                                      BorderThickness="0"
                                      RowHeight="38"
                                      SelectionMode="Single"
                                      ColumnHeaderStyle="{StaticResource ReporteColumnHeaderStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="*" />
                                    <DataGridTextColumn Header="Recaudado" Binding="{Binding TotalRecaudado, StringFormat='${0:N2}'}" Width="Auto" />
                                    <DataGridTextColumn Header="%" Binding="{Binding Participacion, StringFormat='{}{0}%'}" Width="Auto" />
                                    <DataGridTextColumn Header="Unidades" Binding="{Binding Unidades}" Width="Auto" />
                                    <DataGridTextColumn Header="Precio prom." Binding="{Binding PrecioPromedio, StringFormat='${0:N2}'}" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                                <StackPanel>
                                    <!-- NAV 5c | RESUMEN: TotalRecaudadoCategorias, CategoriaLider (la primera de la lista, ordenada por recaudación) y ParticipacionCategoriaLider -->
                                    <TextBlock Text="{Binding TotalRecaudadoCategorias, StringFormat='Total del período: ${0:N2}'}"
                                               FontWeight="SemiBold" FontSize="13"
                                               Foreground="{StaticResource PrimaryBrush}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Categoría líder: " FontSize="12" Foreground="{StaticResource TextBodyBrush}" />
                                        <TextBlock Text="{Binding CategoriaLider}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ParticipacionCategoriaLider, StringFormat='{}{0}% del total recaudado'}"
                                               FontSize="11" Foreground="{StaticResource TextBodyBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- NAV 6 | PRODUCTOS CON STOCK SIN VENTAS (Row 6): el reporte más completo. Lo llena CargarStockSinVentas (ObtenerStockSinVentas, ObtenerConStockSinVentas del repositorio de stock) -->
            <Border Grid.Row="6" Style="{StaticResource MaieCardStyle}" Margin="0,0,0,20" Padding="16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <!-- NAV 6a | COMBO CATEGORÍA PROPIO (a la derecha): CategoriasFiltro / CategoriaStockFiltro → OnCategoriaStockFiltroChanged → solo recarga este reporte. Id 0 = Todas las categorías, que el VM traduce a null -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <TextBlock Text="Categoría:" FontSize="12" Foreground="{StaticResource TextBodyBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding CategoriasFiltro}"
                                      SelectedItem="{Binding CategoriaStockFiltro}"
                                      DisplayMemberPath="Nombre"
                                      Width="200" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="🧊 Productos con Stock sin Ventas"
                                   Style="{StaticResource SubheaderTitleStyle}"
                                   FontSize="15" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- NAV 6b | DOS TARJETAS RESUMEN: ProductosSinVenta (cantidad de filas del reporte) y ValorizadoSinVenta (suma de stock por precio de venta) -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Productos sin rotación" FontSize="12" Foreground="{StaticResource TextBodyBrush}"/>
                                <TextBlock Text="{Binding ProductosSinVenta}"
                                           FontFamily="Noto Serif" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="12,10" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Stock valorizado a precio de venta" FontSize="12" Foreground="{StaticResource TextBodyBrush}"/>
                                <TextBlock Text="{Binding ValorizadoSinVenta, StringFormat='${0:N2}'}"
                                           FontFamily="Noto Serif" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <!-- NAV 6c | TABLA: StockSinVenta (StockSinVentaDTO). Columnas: NombreProducto, NombreCategoria, Stock, Valorizado, UltimaVentaTexto (Nunca vendido si no hay), DiasSinVender y VendidasOtrasSucursales -->
                        <DataGrid ItemsSource="{Binding StockSinVenta}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EFECE6"
                                  Background="White"
                                  BorderThickness="0"
                                  RowHeight="38"
                                  MinHeight="80"
                                  SelectionMode="Single"
                                  ColumnHeaderStyle="{StaticResource ReporteColumnHeaderStyle}">
                            <DataGrid.Columns>
                                <!-- Todo con * para que las columnas se repartan el ancho: con Auto las
                                     numéricas se apretaban y el producto se quedaba con el espacio. -->
                                <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="1.5*" />
                                <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="1*" />
                                <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="0.6*" ElementStyle="{StaticResource ReporteNumeroCellStyle}" />
                                <DataGridTextColumn Header="Valorizado" Binding="{Binding Valorizado, StringFormat='${0:N2}'}" Width="1.1*" ElementStyle="{StaticResource ReporteNumeroCellStyle}" />
                                <DataGridTextColumn Header="Última venta" Binding="{Binding UltimaVentaTexto}" Width="1*" ElementStyle="{StaticResource ReporteNumeroCellStyle}" />
                                <DataGridTextColumn Header="Días" Binding="{Binding DiasSinVender}" Width="0.6*" ElementStyle="{StaticResource ReporteNumeroCellStyle}" />
                                <DataGridTextColumn Header="En otras suc." Binding="{Binding VendidasOtrasSucursales}" Width="0.9*" ElementStyle="{StaticResource ReporteNumeroCellStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- NAV 6d | MENSAJE SIN DATOS: se ve solo si StockSinVentaSinDatos es true (todos los productos con stock vendieron en el período) -->
                        <TextBlock Text="Todos los productos con stock vendieron en el período."
                                   Style="{StaticResource BodyTextStyle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding StockSinVentaSinDatos, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- NAV 7 | FILA DOBLE (Row 7): a la izquierda el ranking de productos (7a) y a la derecha las ventas por sucursal (7b) -->
            <Grid Grid.Row="7" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- NAV 7a | RANKING DE PRODUCTOS: lo llena CargarRankingProductos con los 10 más (o menos) vendidos del período, según MostrarMenosVendidos -->
                <Border Grid.Column="0" Style="{StaticResource MaieCardStyle}" Margin="0,0,12,0" Padding="16">
                    <StackPanel>
                        <!-- NAV 7a-1 | BOTÓN ALTERNAR: Command AlternarRankingCommand, texto TextoBotonRanking. Cambia MostrarMenosVendidos y el título (TituloRanking) cambia solo, por NotifyPropertyChangedFor -->
                        <DockPanel Margin="0,0,0,14">
                            <Button Content="{Binding TextoBotonRanking}"
                                    Command="{Binding AlternarRankingCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    DockPanel.Dock="Right"
                                    VerticalAlignment="Center"
                                    FontSize="12"/>

                            <TextBlock Text="{Binding TituloRanking}" Style="{StaticResource SubheaderTitleStyle}" FontSize="15" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- NAV 7a-2 | LISTA DEL RANKING: TopProductos (TopProductoReporteItem). Cada fila muestra Nombre, UnidadesVendidas y Recaudacion, con una barra debajo -->
                        <ItemsControl ItemsSource="{Binding TopProductos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource PrimaryBrush}"/>
                                            <TextBlock Text="{Binding UnidadesVendidas, StringFormat='{}{0:N0} un.'}" DockPanel.Dock="Right" Margin="12,0,0,0" FontSize="12" Foreground="{StaticResource TextBodyBrush}"/>
                                            <TextBlock Text="{Binding Recaudacion, StringFormat='${0:N2}'}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                                        </DockPanel>

                                        <!-- NAV 7a-3 | BARRA DE PROGRESO: Value = PorcentajeTotal (0 a 100), medido contra el producto más vendido, que vale 100 -->
                                        <ProgressBar Grid.Row="1" 
                                                     Value="{Binding PorcentajeTotal}" 
                                                     Maximum="100" 
                                                     Height="8" 
                                                     Foreground="{StaticResource AccentBrush}"
                                                     Background="{StaticResource SurfaceAltBrush}"
                                                     BorderThickness="0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- NAV 7b | VENTAS POR SUCURSAL: VentasPorSucursal (SucursalVentaReporteItem), lo llena CargarVentasPorSucursal. Compara todas las sucursales: NO usa el filtro de sucursal de la barra de arriba -->
                <Border Grid.Column="1" Style="{StaticResource MaieCardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="📍 Ventas por Sucursal" Style="{StaticResource SubheaderTitleStyle}" FontSize="15" Margin="0,0,0,14"/>

                        <ItemsControl ItemsSource="{Binding VentasPorSucursal}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding SucursalNombre}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryBrush}"/>
                                                <TextBlock Text="{Binding CantidadVentas, StringFormat='{}{0} ventas registradas'}" FontSize="11" Foreground="{StaticResource TextBodyBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding TotalFacturado, StringFormat='${0:N2}'}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding PorcentajeParticipacion, StringFormat='{}{0}% del total'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBodyBrush}" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- NAV 8 | VENTAS POR VENDEDOR (Row 8): torta con VendedorSeries (una porción por vendedor, con su cantidad de ventas). Lo llena CargarVentasPorVendedor. Mensaje sin datos: VendedoresSinDatos -->
            <Border Grid.Row="8" Style="{StaticResource MaieCardStyle}" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Ventas por vendedor"
                        Style="{StaticResource SubheaderTitleStyle}"
                        FontSize="15" Margin="0,0,0,12"/>

                    <Grid Height="300">
                        <lvc:PieChart Series="{Binding VendedorSeries}"
                            LegendPosition="Right"/>
                        <TextBlock Text="No hay ventas de vendedores en el período seleccionado."
                            Style="{StaticResource BodyTextStyle}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding VendedoresSinDatos, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
