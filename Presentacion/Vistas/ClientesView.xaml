<UserControl x:Class="Presentacion.Vistas.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Presentacion.ViewModels"
             xmlns:local="clr-namespace:Presentacion"
             xmlns:ctrl="clr-namespace:Presentacion.Controles"
             mc:Ignorable="d"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             d:DesignHeight="700" d:DesignWidth="950">
    <!-- NAV 1 | ESTRUCTURA: Grid de 2 filas. Row 0 = encabezado, Row 1 = contenido en 2 columnas (formulario de 420 px a la izquierda, lista de clientes a la derecha). ViewModel: ClientesViewModel -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- NAV 2 | ENCABEZADO (Row 0): título y subtítulo fijos, sin bindings -->
        <!-- Header Section -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Gestión de Clientes" Style="{StaticResource HeaderTitleStyle}"/>
            <TextBlock Text="Registro y administración de clientes para la atención en mostrador" Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- NAV Ayuda | BOTÓN AYUDA: control compartido BotonAyuda (Controles/BotonAyuda.xaml). Abre el manual de usuario en PDF. Está en la misma celda del encabezado, alineado arriba a la derecha -->
        <ctrl:BotonAyuda Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- NAV 3 | FORMULARIO (columna izquierda): alta y edición de un cliente. Los campos usan UpdateSourceTrigger=PropertyChanged, así que el ViewModel recibe el valor mientras se escribe. MaxLength limita la longitud desde la vista -->
            <!-- Form -->
            <Border Grid.Column="0"
                    Style="{StaticResource MaieCardStyle}"
                    Padding="24"
                    VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Datos del Cliente" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" FontFamily="Noto Serif" Margin="0,0,0,16"/>

                        <!-- NAV 3a | NOMBRE Y APELLIDO (obligatorios): FormNombre y FormApellido, en dos columnas -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Nombre *" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormNombre, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Padding="8,6" BorderBrush="{StaticResource SecondaryBrush}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Apellido *" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormApellido, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Padding="8,6" BorderBrush="{StaticResource SecondaryBrush}" FontSize="13"/>
                            </StackPanel>
                        </Grid>

                        <!-- NAV 3b | DNI (obligatorio): FormDni, máximo 8 caracteres -->
                        <TextBlock Text="DNI / Documento *" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormDni, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" Padding="8,6" Margin="0,0,0,14" BorderBrush="{StaticResource SecondaryBrush}" FontSize="13"/>

                        <!-- NAV 3c | CORREO ELECTRÓNICO (opcional): FormEmail -->
                        <TextBlock Text="Correo Electrónico" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Padding="8,6" Margin="0,0,0,14" BorderBrush="{StaticResource SecondaryBrush}" FontSize="13"/>

                        <!-- NAV 3d | FECHA DE NACIMIENTO (opcional): FormFechaNacimiento (DatePicker) -->
                        <TextBlock Text="Fecha de Nacimiento" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding FormFechaNacimiento, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,20" BorderBrush="{StaticResource SecondaryBrush}" HorizontalAlignment="Stretch"/>

                        <TextBlock Text="* Campos obligatorios para agilizar la atención en mostrador." FontSize="11" FontStyle="Italic" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <!-- NAV 3e | BOTONES: Cancelar (CancelarCommand), Actualizar (ActualizarCommand, habilitado solo si EsEdicion) y Guardar (GuardarCommand, habilitado solo si NO EsEdicion: el InverseBooleanConverter invierte el bool). EsEdicion pasa a true cuando se elige un cliente de la tabla -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Cancelar"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Padding="12,6"
                                    Margin="0,2,6,2"
                                    Command="{Binding CancelarCommand}"/>
                            <Button Content="Actualizar"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Padding="12,6"
                                    Margin="0,2,6,2"
                                    IsEnabled="{Binding EsEdicion}"
                                    Command="{Binding ActualizarCommand}"/>
                            <Button Content="Guardar"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="14,6"
                                    Margin="0,2,0,2"
                                    IsEnabled="{Binding EsEdicion, Converter={x:Static local:InverseBooleanConverter.Instance}}"
                                    Command="{Binding GuardarCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- NAV 4 | CLIENTES REGISTRADOS (columna derecha): botón de estado, buscador y tabla -->
            <!-- Clientes Registrados -->
            <Border Grid.Column="2" Style="{StaticResource MaieCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- NAV 4a | BOTÓN DE ESTADO: el texto viene de TextoBotonEstado ("Dar de Baja" o "Reactivar" según el cliente elegido) y ejecuta EliminarCommand. Solo se habilita con EsEdicion -->
                    <!-- Header with Actions -->
                    <Grid Grid.Row="0" Margin="20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Clientes Registrados" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" FontFamily="Noto Serif" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{Binding TextoBotonEstado}"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Padding="14,6"
                                    IsEnabled="{Binding EsEdicion}"
                                    Command="{Binding EliminarCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- NAV 4b | BUSCADOR: BusquedaTexto filtra la lista mientras se escribe (OnBusquedaTextoChanged). Busca por DNI, apellido o nombre -->
                    <!-- Search Box -->
                    <Grid Grid.Row="1" Margin="20,0,20,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding BusquedaTexto, UpdateSourceTrigger=PropertyChanged}" 
                                 MaxLength="100"
                                 Padding="8,6" 
                                 FontSize="13" 
                                 BorderBrush="{StaticResource SecondaryBrush}"
                                 ToolTip="Buscar por DNI, Apellido o Nombre"/>
                    </Grid>

                    <!-- NAV 4c | TABLA: ClientesFiltrados (la lista ya filtrada por el buscador). Al elegir una fila se guarda en SelectedCliente (TwoWay) y OnSelectedClienteChanged carga el formulario y activa EsEdicion. Columnas: Dni, Nombre, Apellido, Email, FechaNacimiento, NombreRegistradoPor, CreatedAt -->
                    <!-- DataGrid -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding ClientesFiltrados}"
                              SelectedItem="{Binding SelectedCliente, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EFECE6"
                              Background="White"
                              BorderThickness="0"
                              RowHeight="38"
                              SelectionMode="Single">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontFamily" Value="Noto Serif" />
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White" />
                                <Setter Property="Margin" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="100" />
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                            <DataGridTextColumn Header="Apellido" Binding="{Binding Apellido}" Width="*" />
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*" />
                            <DataGridTextColumn Header="Fecha Nac." Binding="{Binding FechaNacimiento, StringFormat='{}{0:dd/MM/yyyy}'}" Width="100" />
                            <DataGridTextColumn Header="Registrado por" Binding="{Binding NombreRegistradoPor}" Width="1.2*" />
                            <DataGridTextColumn Header="Fecha de Registro" Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy}'}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
