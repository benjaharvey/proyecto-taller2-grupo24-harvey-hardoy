<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentacion"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="Presentacion.MenuPrincipal"
        mc:Ignorable="d"
        Title="Menú Principal" Height="600" Width="700">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <ui:TextBlock TextWrapping="Wrap" Text="Sistema de Gestión de Maie Alfajores" Margin="0,0,0,24" HorizontalAlignment="Center"/>

            <UniformGrid x:Name="GridBotonesMenu" Columns="3" Rows="3">

                <ui:Button x:Name="BtnRegistrarUsuario" Width="180" Height="120" Margin="8">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Person24" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Registrar Usuario" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </ui:Button>

                <ui:Button x:Name="BtnProductos" Width="180" Height="120" Margin="8">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Box24" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Productos" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </ui:Button>

                <ui:Button x:Name="BtnPuntoDeVenta" Width="180" Height="120" Margin="8">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Cart24" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Punto de Venta" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </ui:Button>

                <ui:Button x:Name="BtnStockInsumos" Width="180" Height="120" Margin="8">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="ClipboardTask24" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Stock e Insumos" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </ui:Button>

                <ui:Button x:Name="BtnCocina" Width="180" Height="120" Margin="8">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Food24" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Cocina (Producción)" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </ui:Button>

                <ui:Button x:Name="BtnReportes" Width="180" Height="120" Margin="8">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="DocumentData24" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Reportes" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </ui:Button>

                <ui:Button x:Name="BtnBackup" Width="180" Height="120" Margin="8">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Database24" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Generar Backup" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </ui:Button>

            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>