<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentacion"
        x:Class="Presentacion.MenuPrincipal"
        mc:Ignorable="d"
        Title="Menú Principal" Height="640" Width="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <Style x:Key="MenuTileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="190" />
            <Setter Property="Height" Value="130" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#E2DCD5"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#E5DFD7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Text="MAIE"
                       FontFamily="Noto Serif"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Sistema de Gestión de Maie Alfajores"
                       Style="{StaticResource BodyTextStyle}"
                       FontSize="13"
                       Foreground="{StaticResource SecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,0"/>

            <Separator Margin="0,16,0,24" Background="#E2DCD5" Width="480"/>

            <UniformGrid x:Name="GridBotonesMenu" Columns="3" Rows="3">

                <Button x:Name="BtnRegistrarUsuario" Style="{StaticResource MenuTileButtonStyle}" Click="BtnRegistrarUsuario_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="👤" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock Text="Registrar Usuario" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnProductos" Style="{StaticResource MenuTileButtonStyle}" Click="BtnProductos_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📦" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock Text="Productos" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnPuntoDeVenta" Style="{StaticResource MenuTileButtonStyle}" Click="BtnPuntoDeVenta_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🛒" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock Text="Punto de Venta" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnStockInsumos" Style="{StaticResource MenuTileButtonStyle}" Click="BtnStockInsumos_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📋" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock Text="Stock e Insumos" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnCocina" Style="{StaticResource MenuTileButtonStyle}" Click="BtnCocina_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🍰" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock Text="Cocina (Producción)" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnReportes" Style="{StaticResource MenuTileButtonStyle}" Click="BtnReportes_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📊" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock Text="Reportes" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnBackup" Style="{StaticResource MenuTileButtonStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🗄️" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock Text="Generar Backup" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Button>

            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
