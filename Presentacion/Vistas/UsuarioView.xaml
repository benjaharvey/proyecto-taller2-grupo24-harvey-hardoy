<UserControl x:Class="Presentacion.Vistas.UsuarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:Presentacion.ViewModels"
             xmlns:ctrl="clr-namespace:Presentacion.Controles"
             mc:Ignorable="d"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             d:DataContext="{d:DesignInstance Type=viewModels:UsuarioViewModel}"
             d:DesignHeight="700" d:DesignWidth="950">

    <!-- NAV 0 | RECURSO LOCAL: BoolToVisConverter convierte un bool en Visibility. Se usa en el combo de sucursal (MostrarSucursal) -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <!-- NAV 1 | ESTRUCTURA: Grid de 2 filas. Row 0 = encabezado, Row 1 = contenido en 3 columnas (formulario 360 px, separador 20 px, lista *). ViewModel: UsuarioViewModel, que la vista toma de App.Services en el constructor de UsuarioView.xaml.cs -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- NAV 2 | ENCABEZADO (Row 0): título y subtítulo fijos, sin bindings -->
        <!-- Header Section -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Gestión de Usuarios" Style="{StaticResource HeaderTitleStyle}"/>
            <TextBlock Text="Administrá, registrá y modificá los usuarios del sistema" Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- NAV Ayuda | BOTÓN AYUDA: control compartido BotonAyuda (Controles/BotonAyuda.xaml). Abre el manual de usuario en PDF. Está en la misma celda del encabezado, alineado arriba a la derecha -->
        <ctrl:BotonAyuda Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- NAV 3 | FORMULARIO (columna izquierda): alta y edición de un usuario. Los campos usan UpdateSourceTrigger=PropertyChanged y MaxLength -->
            <!-- Form -->
            <Border Grid.Column="0"
                    Style="{StaticResource MaieCardStyle}"
                    Padding="24"
                    VerticalAlignment="Top">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- NAV 3a | NOMBRE Y APELLIDO: FormNombre y FormApellido, en dos columnas -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Nombre" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FormNombre, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Padding="8,6" BorderBrush="{StaticResource SecondaryBrush}" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Apellido" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FormApellido, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Padding="8,6" BorderBrush="{StaticResource SecondaryBrush}" FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <!-- NAV 3b | DNI: FormDni, máximo 8. Los eventos PreviewTextInput y DataObject.Pasting van al code-behind (SoloDigitos_...) y bloquean todo lo que no sea dígito, incluso al pegar -->
                    <TextBlock Text="DNI" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormDni, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" PreviewTextInput="SoloDigitos_PreviewTextInput" DataObject.Pasting="SoloDigitos_Pasting" Padding="8,6" Margin="0,0,0,14" BorderBrush="{StaticResource SecondaryBrush}" FontSize="13"/>

                    <!-- NAV 3c | EMAIL: FormEmail, máximo 100 -->
                    <TextBlock Text="Email" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Padding="8,6" Margin="0,0,0,14" BorderBrush="{StaticResource SecondaryBrush}" FontSize="13"/>

                    <!-- NAV 3d | CONTRASEÑA Y CONFIRMACIÓN: PasswordBox no admite Binding, así que el evento PasswordChanged del code-behind copia el texto a FormPassword y FormConfirmarPassword. Al editar, dejarlas en blanco mantiene la contraseña actual -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Contraseña" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="txtPassword" PasswordChanged="TxtPassword_PasswordChanged" MaxLength="64" Padding="8,6" BorderBrush="{StaticResource SecondaryBrush}" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Confirmar Contraseña" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="txtConfirmarPassword" PasswordChanged="TxtConfirmarPassword_PasswordChanged" MaxLength="64" Padding="8,6" BorderBrush="{StaticResource SecondaryBrush}" FontSize="13"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Al actualizar un usuario, dejar en blanco para no cambiar la contraseña." FontSize="11" FontStyle="Italic" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <!-- NAV 3e | FECHA DE NACIMIENTO Y DIRECCIÓN: FormFechaNacimiento (DisplayDateEnd = hoy, no deja elegir fechas futuras) y FormDireccion (máximo 200) -->
                    <TextBlock Text="Fecha de Nacimiento" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding FormFechaNacimiento, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,14" BorderBrush="{StaticResource SecondaryBrush}" HorizontalAlignment="Stretch" DisplayDateEnd="{x:Static sys:DateTime.Today}" xmlns:sys="clr-namespace:System;assembly=mscorlib"/>

                    <TextBlock Text="Dirección" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormDireccion, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Padding="8,6" Margin="0,0,0,14" BorderBrush="{StaticResource SecondaryBrush}" FontSize="13"/>

                    <!-- NAV 3f | ROL Y SUCURSAL: el combo de rol (RolesDisponibles / FormRolSeleccionado) se deshabilita con PuedeEditarRol (false si el usuario elegido es Admin). El combo de sucursal (SucursalesDisponibles / FormSucursalSeleccionada) solo se ve si MostrarSucursal es true, o sea si el rol elegido es Vendedor -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Rol" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding RolesDisponibles}"
                                      SelectedItem="{Binding FormRolSeleccionado}"
                                      IsEnabled="{Binding PuedeEditarRol}"
                                      Padding="8,6" BorderBrush="{StaticResource SecondaryBrush}" HorizontalAlignment="Stretch"
                                      DisplayMemberPath="Nombre"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0" Visibility="{Binding MostrarSucursal, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="Sucursal" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding SucursalesDisponibles}"
                                      SelectedItem="{Binding FormSucursalSeleccionada}"
                                      Padding="8,6" BorderBrush="{StaticResource SecondaryBrush}" HorizontalAlignment="Stretch"
                                      DisplayMemberPath="Nombre"/>
                        </StackPanel>
                    </Grid>

                    <!-- NAV 3g | BOTONES: Actualizar Usuario (ActualizarCommand, solo con EsEdicion), Guardar Usuario (GuardarCommand, un DataTrigger lo deshabilita cuando EsEdicion es True) y Cancelar (CancelarCommand, limpia el formulario) -->
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <Button Content="Actualizar Usuario"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Padding="14,6"
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding EsEdicion}"
                                    Command="{Binding ActualizarCommand}"/>
                            <Button Content="Guardar Usuario"
                                    Padding="14,6"
                                    Command="{Binding GuardarCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EsEdicion}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <Button Content="Cancelar"
                                Style="{StaticResource OutlineButtonStyle}"
                                HorizontalAlignment="Right"
                                Padding="14,6"
                                Command="{Binding CancelarCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            </Border>

            <!-- NAV 4 | USUARIOS REGISTRADOS (columna derecha): botón de estado, buscador y tabla -->
            <!-- Usuarios Registrados -->
            <Border Grid.Column="2" Style="{StaticResource MaieCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Usuarios Registrados" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" FontFamily="Noto Serif" VerticalAlignment="Center"/>
                            <!-- NAV 4a | BOTÓN DE ESTADO: el texto viene de TextoBotonEstado ("Dar de Baja" o "Reactivar", lo fija OnSelectedUsuarioChanged según Activo) y ejecuta CambiarEstadoCommand. Solo se habilita con EsEdicion -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{Binding TextoBotonEstado}"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        Padding="14,6"
                                        IsEnabled="{Binding EsEdicion}"
                                        Command="{Binding CambiarEstadoCommand}"/>
                            </StackPanel>
                        </Grid>

                        <!-- NAV 4b | BUSCADOR: BusquedaTexto filtra mientras se escribe (nombre, apellido, DNI, email, rol, dirección). Limpiar ejecuta LimpiarBusquedaCommand. El texto gris es un VisualBrush que aparece solo con el Text vacío -->
                        <!-- Search Bar -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding BusquedaTexto, UpdateSourceTrigger=PropertyChanged}"
                                     Grid.Column="0"
                                     MaxLength="100"
                                     Padding="10,6"
                                     BorderBrush="{StaticResource SecondaryBrush}"
                                     FontSize="13"
                                     Margin="0,0,8,0">
                                <TextBox.Resources>
                                    <VisualBrush x:Key="HintBrush" TileMode="None" Opacity="0.6" Stretch="None" AlignmentX="Left">
                                        <VisualBrush.Visual>
                                            <TextBlock Text="🔍  Buscar por nombre, apellido, DNI, email, rol, dirección..." Foreground="{StaticResource TextBodyBrush}" FontSize="12" Margin="10,0,0,0"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </TextBox.Resources>
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Button Grid.Column="1"
                                    Content="Limpiar"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,6"
                                    Command="{Binding LimpiarBusquedaCommand}"/>
                        </Grid>
                    </Grid>

                    <!-- NAV 4c | TABLA: UsuariosFiltrados. La fila elegida va a SelectedUsuario; OnSelectedUsuarioChanged carga el formulario, activa EsEdicion y decide si se puede editar el rol. Las filas con Activo=False se ven con Opacity 0.65. Columnas: NombreCompleto, Dni, Email, NombreRol, NombreSucursal y Estado -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding UsuariosFiltrados}"
                              SelectedItem="{Binding SelectedUsuario}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EFECE6"
                              Background="White"
                              BorderThickness="0"
                              RowHeight="38"
                              SelectionMode="Single">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontFamily" Value="Noto Serif" />
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White" />
                                <Setter Property="Margin" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                        <Setter Property="Opacity" Value="0.65" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding NombreCompleto}" Width="1.5*" />
                            <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="85" />
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*" />
                            <DataGridTextColumn Header="Rol" Binding="{Binding NombreRol}" Width="*" />
                            <DataGridTextColumn Header="Sucursal" Binding="{Binding NombreSucursal}" Width="110" />

                            <!-- NAV 4c-1 | COLUMNA ESTADO: etiqueta de color. Verde con "Activo" por defecto; rojo con "Inactivo" si Activo es False (DataTrigger) -->
                            <!-- Status Column -->
                            <DataGridTemplateColumn Header="Estado" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E6F4EA" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Activo}" Value="False">
                                                            <Setter Property="Background" Value="#FCE8E6" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Activo" />
                                                        <Setter Property="Foreground" Value="#137333" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                <Setter Property="Text" Value="Inactivo" />
                                                                <Setter Property="Foreground" Value="#C5221F" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
