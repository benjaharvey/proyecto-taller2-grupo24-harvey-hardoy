<Window x:Class="Presentacion.Vistas.ConfirmarRestauracionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar restauración"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <StackPanel x:Name="PasoAdvertenciaPanel">
            <TextBlock Text="Confirmar restauración de base de datos"
                       FontFamily="Noto Serif"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       TextWrapping="Wrap"/>

            <Border Background="#FBEAEA"
                    BorderBrush="#E2B6B6"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,16,0,0">
                <DockPanel>
                    <TextBlock Text="⚠"
                               FontSize="22"
                               Foreground="#A01B18"
                               Margin="0,0,10,0"
                               VerticalAlignment="Top"/>
                    <TextBlock TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="#7A1412">
                        <Run Text="Vas a reemplazar TODOS los datos actuales de la base por el estado del backup seleccionado. "/>
                        <Run Text="Los datos creados o modificados después de esa fecha se perderán. "/>
                        <Run Text="Esta acción no se puede deshacer." FontWeight="SemiBold"/>
                    </TextBlock>
                </DockPanel>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Archivo:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,12,6"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ArchivoValor" FontSize="13" Foreground="{StaticResource TextBodyBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Fecha del backup:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,12,6"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="FechaValor" FontSize="13" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Tamaño:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,12,6"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TamanoValor" FontSize="13" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Creado por:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,12,6"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CreadoPorValor" FontSize="13" Foreground="{StaticResource TextBodyBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Ruta:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,12,0"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="RutaValor" FontSize="12" Foreground="{StaticResource TextBodyBrush}" TextWrapping="Wrap"/>
            </Grid>

            <CheckBox x:Name="EntiendoCheck"
                      Content="Entiendo que los datos actuales serán reemplazados"
                      FontSize="13"
                      Foreground="{StaticResource TextBodyBrush}"
                      Margin="0,18,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancelar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        IsCancel="True"/>
                <Button Content="Continuar"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="16,8"
                        IsEnabled="{Binding IsChecked, ElementName=EntiendoCheck}"
                        Click="Continuar_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="PasoConfirmacionPanel" Visibility="Collapsed">
            <TextBlock Text="Confirmación final"
                       FontFamily="Noto Serif"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"/>

            <TextBlock FontSize="13"
                       Foreground="{StaticResource TextBodyBrush}"
                       TextWrapping="Wrap"
                       Margin="0,14,0,0">
                <Run Text="Escribí "/>
                <Run Text="RESTAURAR" FontWeight="Bold" Foreground="#A01B18"/>
                <Run Text=" para confirmar la operación."/>
            </TextBlock>

            <TextBox x:Name="ConfirmacionTextBox"
                     Padding="8,6"
                     FontSize="14"
                     Margin="0,10,0,0"
                     BorderBrush="{StaticResource SecondaryBrush}"
                     TextChanged="ConfirmacionTextBox_TextChanged"/>

            <TextBlock Text="La comparación distingue mayúsculas de minúsculas."
                       FontSize="11"
                       Foreground="{StaticResource TextBodyBrush}"
                       Margin="0,6,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Volver"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        Click="Volver_Click"/>
                <Button x:Name="RestaurarButton"
                        Content="Restaurar"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="16,8"
                        IsEnabled="False"
                        IsDefault="True"
                        Click="Restaurar_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
