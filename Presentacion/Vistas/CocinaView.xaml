<UserControl x:Class="Presentacion.Vistas.CocinaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Presentacion.ViewModels"
             xmlns:ctrl="clr-namespace:Presentacion.Controles"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- NAV 1 | ENCABEZADO: título y subtítulo de la pantalla (texto fijo, sin bindings) -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Cocina y Elaboración Central" Style="{StaticResource HeaderTitleStyle}"/>
                <TextBlock Text="Consumo de stock global de insumos por receta y reposición a sucursales" Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- NAV Ayuda | BOTÓN AYUDA: control compartido BotonAyuda (Controles/BotonAyuda.xaml). Abre el manual de usuario en PDF. Está en la misma celda del encabezado, alineado arriba a la derecha -->
            <ctrl:BotonAyuda HorizontalAlignment="Right" VerticalAlignment="Top" />
        </Grid>

        <!-- NAV 2 | TARJETA DE ELABORACIÓN (RF-09 / RF-10): dos columnas. Izquierda = formulario (340 px), derecha = cálculo de insumos. Todo se enlaza a CocinaViewModel -->
        <Border Grid.Row="1" Style="{StaticResource MaieCardStyle}" Margin="0,0,0,16" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- NAV 2a | COLUMNA IZQUIERDA, FORMULARIO: producto, cantidad, sucursal destino y botón. Es lo que el cocinero completa -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Registrar Elaboración" Style="{StaticResource SubheaderTitleStyle}" Margin="0,0,0,12"/>

                    <!-- NAV 2a-1 | COMBO PRODUCTO: ProductosDisponibles (solo productos con receta, CargarProductos) / ProductoSeleccionado → OnProductoSeleccionadoChanged → ActualizarFactibilidad() -->
                    <TextBlock Text="Producto a Elaborar (*)" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding ProductosDisponibles}" 
                              SelectedItem="{Binding ProductoSeleccionado}"
                              DisplayMemberPath="Nombre"
                              Padding="8,6" 
                              Margin="0,0,0,12" 
                              BorderBrush="{StaticResource SecondaryBrush}"/>

                    <!-- NAV 2a-2 | CANTIDAD A PRODUCIR: CantidadAElaborar (int). UpdateSourceTrigger=PropertyChanged → recalcula en cada tecla (OnCantidadAElaborarChanged → ActualizarFactibilidad). MaxLength 7 -->
                    <TextBlock Text="Cantidad a Producir (unidades) (*)" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CantidadAElaborar, UpdateSourceTrigger=PropertyChanged}" 
                             MaxLength="7"
                            
                             Padding="8,6" 
                             Margin="0,0,0,12" 
                             BorderBrush="{StaticResource SecondaryBrush}"
                             FontSize="14"
                             FontWeight="SemiBold"/>

                    <!-- NAV 2a-3 | COMBO SUCURSAL DESTINO: Sucursales (nombres, CargarSucursales) / SucursalDestino (string). RegistrarProduccionYEnvio busca el Id por nombre en _sucursalesDb -->
                    <TextBlock Text="Sucursal de Destino (para reponer stock) (*)" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Sucursales}" 
                              SelectedItem="{Binding SucursalDestino}"
                              Padding="8,6" 
                              Margin="0,0,0,16" 
                              BorderBrush="{StaticResource SecondaryBrush}"/>

                    <!-- NAV 2a-4 | BOTÓN ELABORAR Y DESPACHAR (RF-10): Command RegistrarProduccionYEnvioCommand. El DataTrigger de abajo lo deshabilita (IsEnabled False) cuando EsProduccionFactible es False -->
                    <Button Content="🧑‍🍳 Elaborar y Despachar" 
                            Command="{Binding RegistrarProduccionYEnvioCommand}"
                            FontSize="13"
                            Padding="16,10"
                            HorizontalAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsProduccionFactible}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Rectangle Grid.Column="1" Fill="#E2DCD5" Width="1" HorizontalAlignment="Center"/>

                <!-- NAV 2b | COLUMNA DERECHA, ANÁLISIS DE FACTIBILIDAD (RF-09): lista de insumos de la receta + banner. Todo lo arma ActualizarFactibilidad() -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- NAV 2b-1 | TÍTULO DEL ANÁLISIS: texto fijo (sin bindings) -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Cálculo de Insumos según Receta" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Stock Global Cocina" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextBodyBrush}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- NAV 2b-2 | LISTA DE CONSUMOS: ItemsSource CalculoConsumos. Una fila por insumo de la receta (clase ConsumoInsumoItem del ViewModel). El DataTemplate dibuja cada fila -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding CalculoConsumos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E5DFD7" BorderThickness="0,0,0,1" Padding="4,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding InsumoNombre}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                            <!-- NAV 2b-2a | REQUERIDO: TotalRequerido = CantidadPorUnidad x CantidadAElaborar (redondeado a 5 decimales en ActualizarFactibilidad) -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Requerido: " FontSize="11" Foreground="{StaticResource TextBodyBrush}"/>
                                                <TextBlock Text="{Binding TotalRequerido, StringFormat='{}{0:0.#####}'}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding UnidadMedida, StringFormat='{} {0}'}" FontSize="11" Foreground="{StaticResource TextBodyBrush}"/>
                                            </StackPanel>

                                            <!-- NAV 2b-2b | DISPONIBLE: StockGlobalDisponible = stock actual del insumo en la cocina central (se carga en CargarProductos) -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Disponible: " FontSize="11" Foreground="{StaticResource TextBodyBrush}"/>
                                                <TextBlock Text="{Binding StockGlobalDisponible, StringFormat='{}{0:0.#####}'}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding UnidadMedida, StringFormat='{} {0}'}" FontSize="11" Foreground="{StaticResource TextBodyBrush}"/>
                                            </StackPanel>

                                            <!-- NAV 2b-2c | ETIQUETA DE ESTADO: por defecto verde con Suficiente; el DataTrigger sobre EsSuficiente (propiedad calculada: Disponible >= Requerido) la pasa a rojo con Faltante. Lo mismo hace con el fondo del Border -->
                                            <Border Grid.Column="3" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E6F4EA" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EsSuficiente}" Value="False">
                                                                <Setter Property="Background" Value="#FCE8E6" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Suficiente" />
                                                            <Setter Property="Foreground" Value="#137333" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EsSuficiente}" Value="False">
                                                                    <Setter Property="Text" Value="Faltante" />
                                                                    <Setter Property="Foreground" Value="#C5221F" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- NAV 2b-3 | BANNER DE FACTIBILIDAD: muestra MensajeFactibilidad. Verde si EsProduccionFactible, amarillo (DataTrigger) si es False, con la lista de lo que falta -->
                    <Border Grid.Row="2" CornerRadius="6" Padding="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E6F4EA" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsProduccionFactible}" Value="False">
                                        <Setter Property="Background" Value="#FEF7E0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding MensajeFactibilidad}" FontWeight="SemiBold" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#137333" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EsProduccionFactible}" Value="False">
                                            <Setter Property="Foreground" Value="#B06000" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- NAV 3 | HISTORIAL DE PRODUCCIONES (RF-11): tarjeta inferior (Grid.Row 2) con un encabezado y una tabla. Datos: HistorialProduccion (CargarHistorial → ListarProducciones) -->
        <Border Grid.Row="2" Style="{StaticResource MaieCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- NAV 3a | ENCABEZADO DEL HISTORIAL: título fijo de la tarjeta -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" Padding="14,10" BorderBrush="#E2DCD5" BorderThickness="0,0,0,1">
                    <TextBlock Text="Historial de Producciones y Envíos a Sucursal" Style="{StaticResource SubheaderTitleStyle}" FontSize="15"/>
                </Border>

                <!-- NAV 3b | TABLA DEL HISTORIAL: ItemsSource HistorialProduccion (ProduccionHistoricaItem). Solo lectura (IsReadOnly), sin comandos ni botones: es una vista de consulta -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding HistorialProduccion}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EFECE6"
                          Background="White"
                          BorderThickness="0"
                          RowHeight="44"
                          SelectionMode="Single">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontFamily" Value="Noto Serif" />
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
                        </Style>
                    </DataGrid.Resources>

                    <!-- NAV 3c | COLUMNAS: cada Binding es una propiedad de ProduccionHistoricaItem (CodigoLote = PRD-Id con 4 dígitos, FechaHora, ProductoNombre, CantidadElaborada, SucursalDestino, Cocinero) -->
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Lote N°" Binding="{Binding CodigoLote}" Width="120" />
                        <DataGridTextColumn Header="Fecha / Hora" Binding="{Binding FechaHora, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="135" />
                        <DataGridTextColumn Header="Producto Elaborado" Binding="{Binding ProductoNombre}" Width="2*" />
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadElaborada, StringFormat='{}{0} un.'}" Width="90" />
                        <DataGridTextColumn Header="Sucursal Destino" Binding="{Binding SucursalDestino}" Width="1.4*" />
                        <DataGridTextColumn Header="Registrado por" Binding="{Binding Cocinero}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
