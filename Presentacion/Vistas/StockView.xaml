<UserControl x:Class="Presentacion.Vistas.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Presentacion.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000">

    <UserControl.DataContext>
        <vm:StockViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Control de Stock e Insumos" Style="{StaticResource HeaderTitleStyle}"/>
                <TextBlock Text="Existencias por sucursal e inventario global de insumos para elaboración" Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Tab Switcher -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="📦 Productos por Sucursal" 
                                 GroupName="StockTabs"
                                 IsChecked="True"
                                 Command="{Binding CambiarTabCommand}"
                                 CommandParameter="Productos"
                                 Padding="14,8"
                                 Cursor="Hand">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="bdr" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="{TemplateBinding Content}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Medium"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bdr" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <RadioButton Content="🌾 Insumos Globales (Cocina)" 
                                 GroupName="StockTabs"
                                 Command="{Binding CambiarTabCommand}"
                                 CommandParameter="Insumos"
                                 Padding="14,8"
                                 Cursor="Hand">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="bdr" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="{TemplateBinding Content}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Medium"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bdr" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filters Section -->
        <Border Grid.Row="1" Style="{StaticResource MaieCardStyle}" Margin="0,0,0,16" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <TextBox Grid.Column="0" 
                         Text="{Binding BusquedaTexto, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6"
                         Margin="0,0,10,0"
                         BorderBrush="{StaticResource SecondaryBrush}"
                         FontSize="13">
                    <TextBox.Resources>
                        <VisualBrush x:Key="HintBrush" TileMode="None" Opacity="0.5" Stretch="None" AlignmentX="Left">
                            <VisualBrush.Visual>
                                <TextBlock Text="🔍 Buscar por nombre o código..." Foreground="{StaticResource TextBodyBrush}" FontSize="12" Margin="4,0,0,0"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Branch Filter -->
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding Sucursales}" 
                          SelectedItem="{Binding FiltroSucursal}"
                          Margin="0,0,10,0"
                          Padding="8,6"
                          BorderBrush="{StaticResource SecondaryBrush}"/>

                <!-- Category Filter -->
                <ComboBox Grid.Column="2" 
                          ItemsSource="{Binding Categorias}" 
                          SelectedItem="{Binding FiltroCategoria}"
                          Margin="0,0,10,0"
                          Padding="8,6"
                          BorderBrush="{StaticResource SecondaryBrush}"/>

                <!-- Insumo Action Button (visible in Insumos tab) -->
                <Button Grid.Column="3" 
                        Content="+ Ingreso de Insumos"
                        Command="{Binding AbrirIngresoInsumoCommand}"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="14,6"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TabActivo}" Value="Insumos">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- TAB 1: PRODUCTOS POR SUCURSAL TABLE -->
        <Border Grid.Row="2" Padding="0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource MaieCardStyle}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TabActivo}" Value="Productos">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DataGrid ItemsSource="{Binding StockProductos}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EFECE6"
                      Background="White"
                      BorderThickness="0"
                      RowHeight="46"
                      SelectionMode="Single">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontFamily" Value="Noto Serif" />
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="100" />
                    <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="2*" />
                    <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="*" />
                    <DataGridTextColumn Header="Sucursal" Binding="{Binding Sucursal}" Width="1.5*" />
                    <DataGridTextColumn Header="Stock Actual" Binding="{Binding StockActual, StringFormat='{}{0} un.'}" Width="110" />
                    <DataGridTextColumn Header="Mínimo" Binding="{Binding StockMinimo, StringFormat='{}{0} un.'}" Width="90" />

                    <!-- Alert / Status -->
                    <DataGridTemplateColumn Header="Nivel de Stock" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E6F4EA" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NivelAlerta}" Value="Bajo Stock">
                                                    <Setter Property="Background" Value="#FEF7E0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NivelAlerta}" Value="Crítico (Sin Stock)">
                                                    <Setter Property="Background" Value="#FCE8E6" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding NivelAlerta}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#137333" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NivelAlerta}" Value="Bajo Stock">
                                                        <Setter Property="Foreground" Value="#B06000" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NivelAlerta}" Value="Crítico (Sin Stock)">
                                                        <Setter Property="Foreground" Value="#C5221F" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions (RF-13 Ajuste manual de stock) -->
                    <DataGridTemplateColumn Header="Acciones" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="⚙️ Ajustar" 
                                        Command="{Binding DataContext.AbrirAjusteProductoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        FontWeight="SemiBold"
                                        FontSize="11"
                                        BorderThickness="0"
                                        Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- TAB 2: INSUMOS GLOBALES COCINA TABLE -->
        <Border Grid.Row="2" Padding="0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource MaieCardStyle}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TabActivo}" Value="Insumos">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DataGrid ItemsSource="{Binding InsumosGlobales}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EFECE6"
                      Background="White"
                      BorderThickness="0"
                      RowHeight="46"
                      SelectionMode="Single">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontFamily" Value="Noto Serif" />
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="110" />
                    <DataGridTextColumn Header="Insumo (Cocina Central)" Binding="{Binding Nombre}" Width="3*" />
                    <DataGridTextColumn Header="Existencia Actual" Binding="{Binding StockActual, StringFormat='{}{0:N1}'}" Width="130" />
                    <DataGridTextColumn Header="Unidad" Binding="{Binding UnidadMedida}" Width="90" />
                    <DataGridTextColumn Header="Stock Mínimo" Binding="{Binding StockMinimo, StringFormat='{}{0:N1}'}" Width="110" />

                    <!-- Status -->
                    <DataGridTemplateColumn Header="Estado" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E6F4EA" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NivelAlerta}" Value="Bajo Stock">
                                                    <Setter Property="Background" Value="#FEF7E0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding NivelAlerta}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#137333" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NivelAlerta}" Value="Bajo Stock">
                                                        <Setter Property="Foreground" Value="#B06000" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="Acciones" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="➕ Ingreso" 
                                        Command="{Binding DataContext.AbrirIngresoInsumoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        Foreground="{StaticResource AccentBrush}"
                                        FontWeight="SemiBold"
                                        FontSize="11"
                                        BorderThickness="0"
                                        Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- MODAL: Ajuste de Stock de Producto (RF-13) -->
        <Grid Grid.RowSpan="3" Background="#70000000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MostrarDialogoAjusteProducto}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Width="420" Background="White" CornerRadius="8" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Ajuste de Stock de Producto" Style="{StaticResource SubheaderTitleStyle}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ProductoAjustando.Nombre}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" FontSize="13" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding ProductoAjustando.Sucursal, StringFormat='{}En: {0}'}" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Existencia Actual" FontSize="11" Foreground="{StaticResource TextBodyBrush}"/>
                            <TextBlock Text="{Binding ProductoAjustando.StockActual, StringFormat='{}{0} un.'}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Nueva Existencia (*)" FontSize="11" Foreground="{StaticResource TextBodyBrush}"/>
                            <TextBox Text="{Binding NuevoStockProducto}" Padding="6,4" Margin="0,4,0,0" BorderBrush="{StaticResource SecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Motivo del Ajuste (*)" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding MotivosAjuste}" SelectedItem="{Binding MotivoAjusteProducto}" Padding="6,4" Margin="0,0,0,20" BorderBrush="{StaticResource SecondaryBrush}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" 
                                Command="{Binding CerrarAjusteProductoCommand}"
                                Background="Transparent" 
                                Foreground="{StaticResource TextBodyBrush}"
                                BorderBrush="{StaticResource SecondaryBrush}"
                                BorderThickness="1"
                                Padding="14,6"
                                Margin="0,0,8,0"
                                Cursor="Hand"/>
                        <Button Content="Confirmar Ajuste" 
                                Command="{Binding GuardarAjusteProductoCommand}"
                                Background="{StaticResource PrimaryBrush}" 
                                Foreground="White" 
                                FontWeight="SemiBold"
                                Padding="14,6"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL: Ingreso de Insumos Globales (RF-14) -->
        <Grid Grid.RowSpan="3" Background="#70000000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MostrarDialogoIngresoInsumo}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Width="420" Background="White" CornerRadius="8" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Registrar Ingreso de Insumos" Style="{StaticResource SubheaderTitleStyle}" Margin="0,0,0,4"/>
                    <TextBlock Text="Incrementa el stock de cocina central por compra/recepción" Style="{StaticResource BodyTextStyle}" FontSize="12" Margin="0,0,0,16"/>

                    <TextBlock Text="Insumo Seleccionado (*)" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding InsumosGlobales}" 
                              SelectedItem="{Binding InsumoSeleccionado}" 
                              DisplayMemberPath="Nombre"
                              Padding="6,4" 
                              Margin="0,0,0,12" 
                              BorderBrush="{StaticResource SecondaryBrush}"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Cantidad a Ingresar (*)" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding CantidadIngresoInsumo}" Padding="6,4" BorderBrush="{StaticResource SecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,4">
                            <TextBlock Text="{Binding InsumoSeleccionado.UnidadMedida}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Comprobante / N° Factura / Proveedor (Opcional)" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ComprobanteInsumo}" Padding="6,4" Margin="0,0,0,20" BorderBrush="{StaticResource SecondaryBrush}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" 
                                Command="{Binding CerrarIngresoInsumoCommand}"
                                Background="Transparent" 
                                Foreground="{StaticResource TextBodyBrush}"
                                BorderBrush="{StaticResource SecondaryBrush}"
                                BorderThickness="1"
                                Padding="14,6"
                                Margin="0,0,8,0"
                                Cursor="Hand"/>
                        <Button Content="Registrar Ingreso" 
                                Command="{Binding GuardarIngresoInsumoCommand}"
                                Background="{StaticResource AccentBrush}" 
                                Foreground="White" 
                                FontWeight="SemiBold"
                                Padding="14,6"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
