<UserControl x:Class="Presentacion.Vistas.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Presentacion.ViewModels"
             xmlns:ctrl="clr-namespace:Presentacion.Controles"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StockViewModel}"
             d:DesignHeight="750" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- Para ocultar controles exclusivos del administrador (RF-12 / RF-13) -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- NAV Ayuda | BOTÓN AYUDA (columna 2): control compartido BotonAyuda (Controles/BotonAyuda.xaml). Abre el manual de usuario en PDF. Va en su propia columna porque la columna 1 tiene las pestañas -->
            <ctrl:BotonAyuda Grid.Column="2" VerticalAlignment="Top" Margin="12,0,0,0" />

            <StackPanel Grid.Column="0">
                <TextBlock Text="Control de Stock e Insumos" Style="{StaticResource HeaderTitleStyle}"/>
                <TextBlock Text="Existencias por sucursal e inventario global de insumos para elaboración" Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- NAV 1 | PESTAÑAS: 2 RadioButton → CambiarTabCommand("Productos"/"Insumos") → StockViewModel.CambiarTab → TabActivo. Visibility = permiso por rol (PuedeVerProductosTab / PuedeVerInsumosTab) -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="📦 Productos por Sucursal"
                                 GroupName="StockTabs"
                                 IsChecked="True"
                                 Command="{Binding CambiarTabCommand}"
                                 CommandParameter="Productos"
                                 Padding="14,8"
                                 Cursor="Hand"
                                 Visibility="{Binding PuedeVerProductosTab, Converter={StaticResource BoolToVis}}">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="bdr" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <TextBlock x:Name="txt" Text="{TemplateBinding Content}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Medium"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bdr" Property="Background" Value="#E5DFD7"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bdr" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                    <Setter TargetName="txt" Property="FontWeight" Value="Bold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <RadioButton Content="🌾 Insumos Globales (Cocina)"
                                 GroupName="StockTabs"
                                 Command="{Binding CambiarTabCommand}"
                                 CommandParameter="Insumos"
                                 Padding="14,8"
                                 Cursor="Hand"
                                 Visibility="{Binding PuedeVerInsumosTab, Converter={StaticResource BoolToVis}}">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="bdr" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <TextBlock x:Name="txt" Text="{TemplateBinding Content}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Medium"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bdr" Property="Background" Value="#E5DFD7"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bdr" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                    <Setter TargetName="txt" Property="FontWeight" Value="Bold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                </StackPanel>
            </Border>
        </Grid>

        <!-- NAV 2 | BARRA DE FILTROS: buscador, combos y botones de insumos. Cada filtro termina en CargarStock() -->
        <Border Grid.Row="1" Style="{StaticResource MaieCardStyle}" Margin="0,0,0,16" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- NAV 2a | BUSCADOR: BusquedaTexto → OnBusquedaTextoChanged → CargarStock() y además copia el texto a InsumosVM.BusquedaTexto -->
                <TextBox Grid.Column="0" 
                         Text="{Binding BusquedaTexto, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="100"
                         Padding="12,8"
                         Margin="0,0,10,0"
                         BorderBrush="{StaticResource SecondaryBrush}"
                         FontSize="13">
                    <TextBox.Resources>
                        <VisualBrush x:Key="HintBrush" TileMode="None" Opacity="0.6" Stretch="None" AlignmentX="Left">
                            <VisualBrush.Visual>
                                <TextBlock Text="🔍  Buscar por nombre" Foreground="{StaticResource TextBodyBrush}" FontSize="12" Margin="18,0,0,0"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- NAV 2b | FILTROS DE PRODUCTOS (sucursal + categoría): visibles solo si TabActivo == "Productos" -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TabActivo}" Value="Productos">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- NAV 2b-1 | COMBO SUCURSAL: Sucursales / FiltroSucursal → OnFiltroSucursalChanged → CargarStock(). Solo admin (EsAdmin). Opciones: CargarSucursales(). RF-12: el vendedor no elige sucursal, ve la suya -->
                    <ComboBox Width="180"
                              ItemsSource="{Binding Sucursales}"
                              SelectedItem="{Binding FiltroSucursal}"
                              Margin="0,0,10,0"
                              Padding="8,6"
                              BorderBrush="{StaticResource SecondaryBrush}"
                              Visibility="{Binding EsAdmin, Converter={StaticResource BoolToVis}}"/>

                    <!-- NAV 2b-2 | COMBO CATEGORÍA: Categorias / FiltroCategoria → OnFiltroCategoriaChanged → CargarStock(). Opciones: CargarCategorias(). Lo ven todos los roles -->
                    <ComboBox Width="160"
                              ItemsSource="{Binding Categorias}" 
                              SelectedItem="{Binding FiltroCategoria}"
                              Margin="0,0,10,0"
                              Padding="8,6"
                              BorderBrush="{StaticResource SecondaryBrush}"/>
                </StackPanel>

                <!-- NAV 2c | BOTONES DE INSUMOS (solo si TabActivo == "Insumos"): Nuevo Insumo → modal NAV 7 / Ingreso de Stock → modal NAV 6. Ambos comandos viven en InsumoViewModel (InsumosVM) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TabActivo}" Value="Insumos">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button Content="➕ Nuevo Insumo"
                            Command="{Binding InsumosVM.AbrirNuevoInsumoCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="12,6"
                            Margin="0,0,8,0"/>

                    <Button Content="📥 Ingreso de Stock"
                            Command="{Binding InsumosVM.AbrirIngresoInsumoCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- NAV 3 | GRILLA DE PRODUCTOS (visible si TabActivo == "Productos"): ItemsSource = StockProductos, lista de StockProductoItem que arma AplicarStock() -->
        <Border Grid.Row="2" Padding="0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource MaieCardStyle}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TabActivo}" Value="Productos">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DataGrid ItemsSource="{Binding StockProductos}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EFECE6"
                      Background="White"
                      BorderThickness="0"
                      RowHeight="46"
                      SelectionMode="Single">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontFamily" Value="Noto Serif" />
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="100" />
                    <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="2*" />
                    <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="*" />
                    <DataGridTextColumn Header="Sucursal" Binding="{Binding Sucursal}" Width="1.5*" />
                    <DataGridTextColumn Header="Stock Actual" Binding="{Binding StockActual, StringFormat='{}{0} un.'}" Width="110" />
                    <DataGridTextColumn Header="Mínimo" Binding="{Binding StockMinimo, StringFormat='{}{0} un.'}" Width="90" />

                    <!-- NAV 3a | COLUMNA NIVEL DE STOCK: texto y color según StockProductoItem.NivelAlerta (Bajo Stock / Crítico (Sin Stock)); el mínimo es fijo en 15 -->
                    <DataGridTemplateColumn Header="Nivel de Stock" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E6F4EA" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NivelAlerta}" Value="Bajo Stock">
                                                    <Setter Property="Background" Value="#FEF7E0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NivelAlerta}" Value="Crítico (Sin Stock)">
                                                    <Setter Property="Background" Value="#FCE8E6" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding NivelAlerta}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#137333" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NivelAlerta}" Value="Bajo Stock">
                                                        <Setter Property="Foreground" Value="#B06000" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NivelAlerta}" Value="Crítico (Sin Stock)">
                                                        <Setter Property="Foreground" Value="#C5221F" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- NAV 3b | BOTÓN AJUSTAR (RF-13, solo admin): AbrirAjusteProductoCommand(fila) → modal NAV 5. La columna se oculta en StockView.xaml.cs (AplicarPermisosPorRol) si no es admin -->
                    <DataGridTemplateColumn x:Name="ColumnaAjustes" Header="Acciones" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="⚙️ Ajustar" 
                                        Command="{Binding DataContext.AbrirAjusteProductoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource GhostIconButton}"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        FontWeight="SemiBold"
                                        FontSize="11"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- NAV 4 | GRILLA DE INSUMOS (visible si TabActivo == "Insumos"): ItemsSource = InsumosVM.InsumosFiltrados (InsumoDTO). SelectedItem → InsumosVM.SelectedInsumo → OnSelectedInsumoChanged -->
        <Border Grid.Row="2" Padding="0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource MaieCardStyle}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TabActivo}" Value="Insumos">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DataGrid ItemsSource="{Binding InsumosVM.InsumosFiltrados}"
                      SelectedItem="{Binding InsumosVM.SelectedInsumo}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EFECE6"
                      Background="White"
                      BorderThickness="0"
                      RowHeight="46"
                      SelectionMode="Single">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontFamily" Value="Noto Serif" />
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="100" />
                    <DataGridTextColumn Header="Insumo (Cocina Central)" Binding="{Binding Nombre}" Width="3*" />
                    <DataGridTextColumn Header="Existencia Actual" Binding="{Binding Stock, StringFormat='{}{0:N3}'}" Width="130" />
                    <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="80" />
                    <DataGridTextColumn Header="Stock Mínimo" Binding="{Binding StockMinimo, StringFormat='{}{0:N3}'}" Width="110" />

                    <!-- NAV 4a | COLUMNA ESTADO DE INSUMO: color según InsumoDTO.NivelAlerta (Bajo Stock / Sin Stock / Inactivo) -->
                    <DataGridTemplateColumn Header="Estado" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E6F4EA" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NivelAlerta}" Value="Bajo Stock">
                                                    <Setter Property="Background" Value="#FEF7E0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NivelAlerta}" Value="Sin Stock">
                                                    <Setter Property="Background" Value="#FCE8E6" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NivelAlerta}" Value="Inactivo">
                                                    <Setter Property="Background" Value="#F1F3F4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding NivelAlerta}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#137333" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NivelAlerta}" Value="Bajo Stock">
                                                        <Setter Property="Foreground" Value="#B06000" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NivelAlerta}" Value="Sin Stock">
                                                        <Setter Property="Foreground" Value="#C5221F" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NivelAlerta}" Value="Inactivo">
                                                        <Setter Property="Foreground" Value="#70757A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- NAV 4b | BOTONES DE FILA: Sumar → AbrirIngresoInsumoCommand(fila) → modal NAV 6 / Estado → CambiarEstadoCommand(fila) (dar de baja o reactivar, con MessageBox). Usan DataContext.InsumosVM porque dentro de la fila el DataContext es el insumo -->
                    <DataGridTemplateColumn Header="Acciones" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="➕ Sumar" 
                                            Command="{Binding DataContext.InsumosVM.AbrirIngresoInsumoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource GhostIconButton}"
                                            Foreground="{StaticResource AccentBrush}"
                                            FontWeight="SemiBold"
                                            FontSize="11"
                                            Margin="0,0,8,0"/>

                                    <Button Content="⚙️ Estado" 
                                            Command="{Binding DataContext.InsumosVM.CambiarEstadoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource GhostIconButton}"
                                            Foreground="{StaticResource PrimaryBrush}"
                                            FontWeight="SemiBold"
                                            FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- NAV 5 | MODAL AJUSTE DE STOCK (RF-13): se abre con MostrarDialogoAjusteProducto. Confirmar → GuardarAjusteProductoCommand → AjustarStockProducto → StockSucursalRepositorio.Ajustar / Cancelar → CerrarAjusteProductoCommand -->
        <Grid Grid.RowSpan="3" Background="#70000000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MostrarDialogoAjusteProducto}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Width="420" Background="White" CornerRadius="8" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Ajuste de Stock de Producto" Style="{StaticResource SubheaderTitleStyle}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ProductoAjustando.Nombre}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" FontSize="13" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding ProductoAjustando.Sucursal, StringFormat='{}En: {0}'}" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Existencia Actual" FontSize="11" Foreground="{StaticResource TextBodyBrush}"/>
                            <TextBlock Text="{Binding ProductoAjustando.StockActual, StringFormat='{}{0} un.'}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Nueva Existencia (*)" FontSize="11" Foreground="{StaticResource TextBodyBrush}"/>
                            <TextBox Text="{Binding NuevoStockProducto}" MaxLength="7" Padding="6,4" Margin="0,4,0,0" BorderBrush="{StaticResource SecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" 
                                Command="{Binding CerrarAjusteProductoCommand}"
                                Style="{StaticResource OutlineButtonStyle}"
                                Padding="14,6"
                                Margin="0,0,8,0"/>
                        <Button Content="Confirmar Ajuste" 
                                Command="{Binding GuardarAjusteProductoCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- NAV 6 | MODAL INGRESO DE INSUMO (RF-14): se abre con InsumosVM.MostrarDialogoIngresoInsumo. Registrar → GuardarIngresoInsumoCommand (suma al stock y llama a ActualizarInsumo) / Cancelar → CerrarIngresoInsumoCommand -->
        <Grid Grid.RowSpan="3" Background="#70000000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding InsumosVM.MostrarDialogoIngresoInsumo}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Width="420" Background="White" CornerRadius="8" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Registrar Ingreso de Stock de Insumo" Style="{StaticResource SubheaderTitleStyle}" Margin="0,0,0,4"/>
                    <TextBlock Text="Incrementa la existencia de cocina central por compra o entrega" Style="{StaticResource BodyTextStyle}" FontSize="12" Margin="0,0,0,16"/>

                    <TextBlock Text="Insumo Seleccionado (*)" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding InsumosVM.InsumosFiltrados}" 
                              SelectedItem="{Binding InsumosVM.InsumoSeleccionadoIngreso}" 
                              DisplayMemberPath="Nombre"
                              Padding="6,4" 
                              Margin="0,0,0,12" 
                              BorderBrush="{StaticResource SecondaryBrush}"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Cantidad a Ingresar (*)" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding InsumosVM.CantidadIngresoInsumo, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" Padding="6,4" BorderBrush="{StaticResource SecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,4">
                            <TextBlock Text="{Binding InsumosVM.InsumoSeleccionadoIngreso.Unidad}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" 
                                Command="{Binding InsumosVM.CerrarIngresoInsumoCommand}"
                                Style="{StaticResource OutlineButtonStyle}"
                                Padding="14,6"
                                Margin="0,0,8,0"/>
                        <Button Content="Registrar Ingreso" 
                                Command="{Binding InsumosVM.GuardarIngresoInsumoCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- NAV 7 | MODAL NUEVO INSUMO (RF-07): se abre con InsumosVM.MostrarDialogoNuevoInsumo. Campos Form* del InsumoViewModel. Crear → GuardarNuevoInsumoCommand → CrearInsumo → InsumoRepositorio.Agregar / Cancelar → CerrarNuevoInsumoCommand -->
        <Grid Grid.RowSpan="3" Background="#70000000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding InsumosVM.MostrarDialogoNuevoInsumo}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Width="420" Background="White" CornerRadius="8" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Nuevo Tipo de Insumo" Style="{StaticResource SubheaderTitleStyle}" Margin="0,0,0,4"/>
                    <TextBlock Text="Dar de alta un nuevo ingrediente o insumo para cocina" Style="{StaticResource BodyTextStyle}" FontSize="12" Margin="0,0,0,16"/>

                    <TextBlock Text="Nombre del Insumo (*)" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding InsumosVM.FormNombre, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Padding="6,4" Margin="0,0,0,10" BorderBrush="{StaticResource SecondaryBrush}"/>

                    <TextBlock Text="Unidad de Medida (*)" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding InsumosVM.UnidadesSugeridas}" SelectedItem="{Binding InsumosVM.FormUnidad}" IsEditable="True" Padding="6,4" Margin="0,0,0,10" BorderBrush="{StaticResource SecondaryBrush}"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Stock Inicial" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding InsumosVM.FormStock, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" Padding="6,4" BorderBrush="{StaticResource SecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Stock Mínimo (Alerta)" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding InsumosVM.FormStockMinimo, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" Padding="6,4" BorderBrush="{StaticResource SecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" 
                                Command="{Binding InsumosVM.CerrarNuevoInsumoCommand}"
                                Style="{StaticResource OutlineButtonStyle}"
                                Padding="14,6"
                                Margin="0,0,8,0"/>
                        <Button Content="Crear Insumo" 
                                Command="{Binding InsumosVM.GuardarNuevoInsumoCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
