<Window x:Class="Presentacion.VistaLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentacion"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Maie - Iniciar Sesión" Height="600" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Style="{StaticResource MaieCardStyle}" Width="340" Padding="28">
            <StackPanel>
                <TextBlock Text="MAIE"
                           FontFamily="Noto Serif"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Dulces Artesanales"
                           Style="{StaticResource BodyTextStyle}"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"/>

                <Separator Margin="0,16,0,20" Background="#E2DCD5"/>

                <TextBlock Text="Iniciar Sesión" Style="{StaticResource SubheaderTitleStyle}" Margin="0,0,0,20"/>

                <TextBlock Text="E-mail" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                <TextBox Padding="8,6"
                         Margin="0,0,0,16"
                         BorderBrush="{StaticResource SecondaryBrush}"
                         FontSize="13"/>

                <TextBlock Text="Contraseña" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                <PasswordBox Padding="8,6"
                             Margin="0,0,0,24"
                             BorderBrush="{StaticResource SecondaryBrush}"
                             FontSize="13"/>

                <Button Content="Ingresar"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        FontSize="13"
                        Padding="14,10"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
