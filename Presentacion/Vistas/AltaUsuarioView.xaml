<UserControl x:Class="Presentacion.Vistas.AltaUsuarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="950">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Alta de Usuario" Style="{StaticResource HeaderTitleStyle}"/>
            <TextBlock Text="Complete los datos para registrar un nuevo usuario" Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Form -->
            <Border Grid.Column="0"
                    Style="{StaticResource MaieCardStyle}"
                    Padding="24"
                    VerticalAlignment="Top">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Nombre" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtNombre" MaxLength="50" Padding="8,6" BorderBrush="{StaticResource SecondaryBrush}" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Apellido" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtApellido" MaxLength="50" Padding="8,6" BorderBrush="{StaticResource SecondaryBrush}" FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="DNI" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtDni" MaxLength="8" PreviewTextInput="SoloDigitos_PreviewTextInput" DataObject.Pasting="SoloDigitos_Pasting" Padding="8,6" Margin="0,0,0,14" BorderBrush="{StaticResource SecondaryBrush}" FontSize="13"/>

                    <TextBlock Text="Email" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtEmail" MaxLength="100" Padding="8,6" Margin="0,0,0,14" BorderBrush="{StaticResource SecondaryBrush}" FontSize="13"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Contraseña" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="txtPassword" MaxLength="64" Padding="8,6" BorderBrush="{StaticResource SecondaryBrush}" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Confirmar Contraseña" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="txtConfirmarPassword" MaxLength="64" Padding="8,6" BorderBrush="{StaticResource SecondaryBrush}" FontSize="13"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Al actualizar un usuario, dejar en blanco para no cambiar la contraseña." FontSize="11" FontStyle="Italic" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <TextBlock Text="Fecha de Nacimiento" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="dtpFechaNacimiento" Padding="8,6" Margin="0,0,0,14" BorderBrush="{StaticResource SecondaryBrush}" HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Dirección" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtDireccion" MaxLength="200" Padding="8,6" Margin="0,0,0,14" BorderBrush="{StaticResource SecondaryBrush}" FontSize="13"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Rol" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbRol" Padding="8,6" BorderBrush="{StaticResource SecondaryBrush}" HorizontalAlignment="Stretch"
                                      DisplayMemberPath="Nombre" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Sucursal Id" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtSucursalId" MaxLength="9" PreviewTextInput="SoloDigitos_PreviewTextInput" DataObject.Pasting="SoloDigitos_Pasting" Padding="8,6" BorderBrush="{StaticResource SecondaryBrush}" FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar"
                                Style="{StaticResource OutlineButtonStyle}"
                                Padding="14,6"
                                Margin="0,0,8,0"
                                Click="BtnCancelar_Click"/>
                        <Button x:Name="btnActualizarUsuario"
                                Content="Actualizar Usuario"
                                Style="{StaticResource OutlineButtonStyle}"
                                Padding="14,6"
                                Margin="0,0,8,0"
                                IsEnabled="False"
                                Click="BtnActualizar_Click"/>
                        <Button x:Name="btnGuardarUsuario"
                                Content="Guardar Usuario"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="14,6"
                                Click="BtnGuardar_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            </Border>

            <!-- Usuarios Registrados -->
            <Border Grid.Column="2" Style="{StaticResource MaieCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Usuarios Registrados" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" FontFamily="Noto Serif" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="btnEliminarUsuario"
                                    Content="Eliminar Usuario"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Padding="14,6"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"
                                    Click="BtnEliminar_Click"/>
                            <Button Content="Recargar lista" Style="{StaticResource OutlineButtonStyle}" Padding="14,6" Click="BtnActualizarLista_Click"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              x:Name="dataGridUsuarios"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EFECE6"
                              Background="White"
                              BorderThickness="0"
                              RowHeight="38"
                              SelectionMode="Single"
                              SelectionChanged="DataGridUsuarios_SelectionChanged">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontFamily" Value="Noto Serif" />
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White" />
                                <Setter Property="Margin" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                            <DataGridTextColumn Header="Apellido" Binding="{Binding Apellido}" Width="*" />
                            <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="90" />
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*" />
                            <DataGridTextColumn Header="Rol" Binding="{Binding NombreRol}" Width="*" />
                            <DataGridTextColumn Header="Sucursal" Binding="{Binding SucursalId}" Width="70" />
                            <DataGridTextColumn Header="Fecha Nac." Binding="{Binding FechaNacimiento, StringFormat='{}{0:dd/MM/yyyy}'}" Width="100" />
                            <DataGridTextColumn Header="Dirección" Binding="{Binding Direccion}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
