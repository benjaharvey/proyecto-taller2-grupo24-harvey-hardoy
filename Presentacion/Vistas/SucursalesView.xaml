<UserControl x:Class="Presentacion.Vistas.SucursalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:Presentacion.ViewModels"
             mc:Ignorable="d"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             d:DataContext="{d:DesignInstance Type=viewModels:SucursalViewModel}"
             d:DesignHeight="700" d:DesignWidth="950">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Gestión de Sucursales" Style="{StaticResource HeaderTitleStyle}"/>
            <TextBlock Text="Administrá los puntos de venta y dependencias operativas del sistema" Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Form Card -->
            <Border Grid.Column="0"
                    Style="{StaticResource MaieCardStyle}"
                    Padding="24"
                    VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Nombre de la Sucursal" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormNombre, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="50"
                                 Padding="8,6"
                                 Margin="0,0,0,14"
                                 BorderBrush="{StaticResource SecondaryBrush}"
                                 FontSize="13"/>

                        <TextBlock Text="Ubicación / Dirección" FontSize="12" Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormUbicacion, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="150"
                                 Padding="8,6"
                                 Margin="0,0,0,14"
                                 BorderBrush="{StaticResource SecondaryBrush}"
                                 FontSize="13"/>

                        <!-- Action Buttons -->
                        <StackPanel Margin="0,10,0,0">
                            <Button Padding="14,8"
                                    Margin="0,0,0,8"
                                    Command="{Binding GuardarCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                        <Setter Property="Content" Value="Crear Sucursal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EsEdicion}" Value="True">
                                                <Setter Property="Content" Value="Guardar Cambios"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="Cancelar / Nuevo"
                                    Padding="14,6"
                                    Command="{Binding CancelarCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Grid Card -->
            <Border Grid.Column="2" Style="{StaticResource MaieCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Sucursales Registradas"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontFamily="Noto Serif"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{Binding TextoBotonEstado}"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        Padding="14,6"
                                        IsEnabled="{Binding EsEdicion}"
                                        Command="{Binding CambiarEstadoCommand}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Search Bar -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding BusquedaTexto, UpdateSourceTrigger=PropertyChanged}"
                                     Grid.Column="0"
                                     Padding="10,6"
                                     BorderBrush="{StaticResource SecondaryBrush}"
                                     FontSize="13"
                                     Margin="0,0,8,0">
                                <TextBox.Resources>
                                    <VisualBrush x:Key="HintBrush" TileMode="None" Opacity="0.6" Stretch="None" AlignmentX="Left">
                                        <VisualBrush.Visual>
                                            <TextBlock Text="🔍  Buscar por nombre, ubicación o estado..."
                                                       Foreground="{StaticResource TextBodyBrush}"
                                                       FontSize="12"
                                                       Margin="10,0,0,0"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </TextBox.Resources>
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Button Grid.Column="1"
                                    Content="Limpiar"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,6"
                                    Command="{Binding LimpiarBusquedaCommand}"/>
                        </Grid>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding SucursalesFiltradas}"
                              SelectedItem="{Binding SelectedSucursal}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EFECE6"
                              Background="White"
                              BorderThickness="0"
                              RowHeight="38"
                              SelectionMode="Single">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontFamily" Value="Noto Serif" />
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White" />
                                <Setter Property="Margin" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding Estado}" Value="INACTIVA">
                                        <Setter Property="Opacity" Value="0.65" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="1.5*" />
                            <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="2*" />

                            <!-- Status Badge Column -->
                            <DataGridTemplateColumn Header="Estado" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E6F4EA" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Estado}" Value="INACTIVA">
                                                            <Setter Property="Background" Value="#FCE8E6" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Activa" />
                                                        <Setter Property="Foreground" Value="#137333" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Estado}" Value="INACTIVA">
                                                                <Setter Property="Text" Value="Inactiva" />
                                                                <Setter Property="Foreground" Value="#C5221F" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
